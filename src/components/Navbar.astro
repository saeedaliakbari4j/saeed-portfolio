---
import AudioEffects from './AudioEffects.astro';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-200" id="main-nav">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-2.5">
    <div class="h-14 px-4 sm:px-5 rounded-2xl bg-white/90 backdrop-blur-md border border-slate-200/90 shadow-xs flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <a href={isFa ? '/' : '/en'} class="flex items-center gap-2 group shrink-0">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-base sm:text-lg font-black tracking-tight text-slate-900 group-hover:text-emerald-600 transition-colors">
          {isFa ? 'سعید علی‌اکبری' : 'Saeed Aliakbari'}
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-5 lg:gap-6 text-xs font-bold text-slate-600">
        <a href="#home" class="py-1 text-slate-900 hover:text-emerald-600 transition-colors">
          {isFa ? 'خانه' : 'Home'}
        </a>
        <a href="#about" class="py-1 hover:text-emerald-600 transition-colors">
          {isFa ? 'درباره من' : 'About'}
        </a>
        <a href="#rag-lab" class="py-1 hover:text-emerald-600 transition-colors flex items-center gap-1.5 text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-md border border-emerald-200/60 font-semibold">
          <span>{isFa ? 'آزمایشگاه RAG' : 'RAG Lab'}</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
        </a>
        <a href="#skills" class="py-1 hover:text-emerald-600 transition-colors">
          {isFa ? 'تخصص‌ها' : 'Skills'}
        </a>
        <a href="#projects" class="py-1 hover:text-emerald-600 transition-colors">
          {isFa ? 'پروژه‌ها' : 'Projects'}
        </a>
        <a href="#experience" class="py-1 hover:text-emerald-600 transition-colors">
          {isFa ? 'سوابق' : 'Career'}
        </a>
        <a href="#contact" class="py-1 hover:text-emerald-600 transition-colors">
          {isFa ? 'ارتباط' : 'Contact'}
        </a>
      </nav>

      <!-- Action Controls -->
      <div class="flex items-center gap-2 shrink-0">
        <!-- Audio Synthesizer Toggle -->
        <AudioEffects lang={lang} />

        <!-- Terminal Quick Trigger -->
        <button
          id="terminal-nav-btn"
          type="button"
          aria-label="Open Terminal HUD"
          title={isFa ? 'ترمینال هوشمند' : 'Console'}
          class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-mono font-bold bg-slate-100 text-slate-700 border border-slate-200 hover:bg-slate-200 transition-all cursor-pointer"
        >
          <span>&gt;_ CLI</span>
        </button>

        <!-- Language Switcher -->
        <div class="flex items-center p-0.5 rounded-lg bg-slate-100 border border-slate-200 text-xs">
          <a
            href="/"
            class={`px-2 py-0.5 rounded-md font-bold transition-all ${
              isFa
                ? 'bg-white text-emerald-700 shadow-xs'
                : 'text-slate-500 hover:text-slate-900'
            }`}
          >
            FA
          </a>
          <a
            href="/en"
            class={`px-2 py-0.5 rounded-md font-bold transition-all ${
              !isFa
                ? 'bg-white text-emerald-700 shadow-xs'
                : 'text-slate-500 hover:text-slate-900'
            }`}
          >
            EN
          </a>
        </div>

        <!-- Mobile Menu Hamburger Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle Menu"
          class="md:hidden p-1.5 text-slate-700 hover:bg-slate-100 rounded-lg"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Drawer Navigation -->
    <div id="mobile-menu" class="hidden md:hidden mt-2 p-3 rounded-2xl bg-white border border-slate-200 shadow-lg flex flex-col gap-1 text-xs font-semibold">
      <a href="#home" class="px-3 py-1.5 text-slate-800 hover:bg-slate-50 rounded-lg mobile-link">
        {isFa ? 'خانه' : 'Home'}
      </a>
      <a href="#about" class="px-3 py-1.5 text-slate-800 hover:bg-slate-50 rounded-lg mobile-link">
        {isFa ? 'درباره من' : 'About'}
      </a>
      <a href="#rag-lab" class="px-3 py-1.5 text-emerald-700 hover:bg-emerald-50 rounded-lg mobile-link flex items-center justify-between">
        <span>{isFa ? 'آزمایشگاه زنده RAG' : 'RAG Lab'}</span>
        <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">LIVE</span>
      </a>
      <a href="#skills" class="px-3 py-1.5 text-slate-800 hover:bg-slate-50 rounded-lg mobile-link">
        {isFa ? 'تخصص‌ها' : 'Skills'}
      </a>
      <a href="#projects" class="px-3 py-1.5 text-slate-800 hover:bg-slate-50 rounded-lg mobile-link">
        {isFa ? 'پروژه‌ها' : 'Projects'}
      </a>
      <a href="#experience" class="px-3 py-1.5 text-slate-800 hover:bg-slate-50 rounded-lg mobile-link">
        {isFa ? 'مسیر حرفه‌ای' : 'Career'}
      </a>
      <a href="#contact" class="px-3 py-1.5 text-slate-800 hover:bg-slate-50 rounded-lg mobile-link">
        {isFa ? 'ارتباط' : 'Contact'}
      </a>
    </div>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });

  const terminalNavBtn = document.getElementById('terminal-nav-btn');
  terminalNavBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-terminal'));
  });
</script>

---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
---

<!-- Floating Terminal Modal / Overlay -->
<div
  id="cyber-terminal-modal"
  class="fixed inset-0 z-50 bg-[#143a2e]/60 backdrop-blur-sm hidden flex items-center justify-center p-4 sm:p-6"
>
  <div
    class="w-full max-w-3xl rounded-2xl bg-[#14261f] border-2 border-[#276652] shadow-2xl overflow-hidden flex flex-col h-[520px] max-h-[85vh] relative"
    id="terminal-window"
  >
    <!-- Top Window Titlebar (Forest Green) -->
    <div class="px-5 py-3.5 bg-[#1d4d3e] border-b border-[#276652] flex items-center justify-between select-none">
      <div class="flex items-center gap-2">
        <button id="terminal-close-btn" class="w-3.5 h-3.5 rounded-full bg-red-400 hover:bg-red-300 cursor-pointer" title="Close"></button>
        <button id="terminal-min-btn" class="w-3.5 h-3.5 rounded-full bg-yellow-400 hover:bg-yellow-300 cursor-pointer" title="Minimize"></button>
        <button id="terminal-max-btn" class="w-3.5 h-3.5 rounded-full bg-emerald-400 hover:bg-emerald-300 cursor-pointer" title="Maximize"></button>
        <span class="ml-3 font-mono text-xs text-white font-bold tracking-wider">
          SAEED_CONSOLE://INTELLIGENCE_KERNEL [v5.2]
        </span>
      </div>

      <div class="flex items-center gap-3 text-xs font-mono text-emerald-200">
        <span class="hidden sm:inline">TYPE 'help' FOR COMMANDS</span>
        <span class="px-2 py-0.5 rounded bg-[#143a2e] border border-[#276652] text-[#f4d5cc]">
          ESC
        </span>
      </div>
    </div>

    <!-- Terminal Output Log Area -->
    <div
      id="terminal-body"
      class="flex-1 p-5 font-mono text-xs sm:text-sm text-emerald-100 overflow-y-auto space-y-2 select-text"
      dir="ltr"
    >
      <div class="text-[#f4d5cc] font-bold">
        ========================================================================<br/>
        &nbsp;&nbsp;SAEED ALIAKBARI // AI ARCHITECT &amp; SOFTWARE ENGINEER<br/>
        &nbsp;&nbsp;RAG Optimization | Mission-Critical Banking | Modern Web<br/>
        ========================================================================
      </div>
      <div class="text-emerald-300">
        System initialized. Knowledge store connected.<br/>
        Type <span class="text-[#e07253] font-bold">help</span> to view commands or ask questions.
      </div>
    </div>

    <!-- Terminal Prompt Input Line -->
    <div class="p-3.5 bg-[#172c24] border-t border-[#276652] flex items-center gap-2" dir="ltr">
      <span class="font-mono text-[#e07253] text-sm font-bold">saeed:~$</span>
      <input
        id="terminal-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        class="flex-1 bg-transparent border-none outline-none font-mono text-xs sm:text-sm text-white placeholder-emerald-600"
        placeholder="Type a command (help, about, skills, projects, rag, contact)..."
      />
      <button
        id="terminal-submit-btn"
        class="px-4 py-1.5 rounded bg-[#e07253] text-white font-mono font-bold text-xs hover:bg-[#cb5e40] cursor-pointer"
      >
        SEND
      </button>
    </div>

  </div>
</div>

<!-- Floating Button at Bottom Right -->
<div class="fixed bottom-6 end-6 z-40">
  <button
    id="terminal-floating-btn"
    type="button"
    aria-label="Open Terminal"
    class="flex items-center gap-2 px-4 py-3 rounded-full bg-[#1d4d3e] hover:bg-[#143a2e] text-white border-2 border-[#276652] text-xs font-bold shadow-xl transition-all cursor-pointer group"
  >
    <span class="w-2.5 h-2.5 rounded-full bg-[#e07253] animate-pulse"></span>
    <span>{isFa ? 'کنسول تعاملی [~]' : 'Console [~]'}</span>
  </button>
</div>

<script>
  const modal = document.getElementById('cyber-terminal-modal');
  const floatingBtn = document.getElementById('terminal-floating-btn');
  const closeBtn = document.getElementById('terminal-close-btn');
  const termBody = document.getElementById('terminal-body');
  const termInput = document.getElementById('terminal-input') as HTMLInputElement;
  const submitBtn = document.getElementById('terminal-submit-btn');

  function openTerminal() {
    modal?.classList.remove('hidden');
    setTimeout(() => termInput?.focus(), 50);
  }

  function closeTerminal() {
    modal?.classList.add('hidden');
  }

  floatingBtn?.addEventListener('click', openTerminal);
  closeBtn?.addEventListener('click', closeTerminal);

  window.addEventListener('toggle-terminal', () => {
    if (modal?.classList.contains('hidden')) {
      openTerminal();
    } else {
      closeTerminal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === '`' || e.key === '~') {
      e.preventDefault();
      if (modal?.classList.contains('hidden')) {
        openTerminal();
      } else {
        closeTerminal();
      }
    }
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeTerminal();
    }
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeTerminal();
    }
  });

  function appendLine(content: string, isCommand = false) {
    if (!termBody) return;
    const div = document.createElement('div');
    if (isCommand) {
      div.className = 'text-[#e07253] font-bold';
      div.textContent = `saeed:~$ ${content}`;
    } else {
      div.className = 'text-emerald-100 leading-relaxed';
      div.innerHTML = content;
    }
    termBody.appendChild(div);
    termBody.scrollTop = termBody.scrollHeight;
  }

  async function processCommand(cmd: string) {
    const raw = cmd.trim();
    if (!raw) return;

    appendLine(raw, true);
    if ((window as any).cyberAudio?.isEnabled?.()) {
      (window as any).cyberAudio.playKeyClick();
    }

    const lower = raw.toLowerCase();

    switch (lower) {
      case 'help':
        appendLine(`
          <span class="text-[#f4d5cc] font-bold">AVAILABLE COMMANDS:</span><br/>
          &nbsp;&nbsp;<span class="text-[#e07253]">help</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- Show commands list<br/>
          &nbsp;&nbsp;<span class="text-[#e07253]">about</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- Saeed's background &amp; history<br/>
          &nbsp;&nbsp;<span class="text-[#e07253]">skills</span>&nbsp;&nbsp;&nbsp;&nbsp;- Engineering mastery &amp; tech domains<br/>
          &nbsp;&nbsp;<span class="text-[#e07253]">projects</span>&nbsp;&nbsp;- Featured GitHub repositories<br/>
          &nbsp;&nbsp;<span class="text-[#e07253]">rag</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- Run simulated RAG vector lookup<br/>
          &nbsp;&nbsp;<span class="text-[#e07253]">contact</span>&nbsp;&nbsp;&nbsp;- Direct communication channels<br/>
          &nbsp;&nbsp;<span class="text-[#e07253]">sudo hire</span>&nbsp;- Collaboration protocol<br/>
          &nbsp;&nbsp;<span class="text-[#e07253]">clear</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- Clear screen<br/>
        `);
        break;

      case 'about':
        appendLine(`
          <span class="text-[#f4d5cc] font-bold">SAEED ALIAKBARI:</span><br/>
          - Lead AI Architect &amp; Software Engineer with 10+ years experience.<br/>
          - Co-Founder &amp; Tech Lead at Rayamate.<br/>
          - Senior AI &amp; BPM Engineer at Behpardakht Mellat.<br/>
          - Alumnus of Shahid Beheshti University (M.Sc. research on RAG).<br/>
          - Location: Tehran, Iran | Open to global high-impact collaborations.
        `);
        break;

      case 'skills':
        appendLine(`
          <span class="text-[#f4d5cc] font-bold">[ENGINEERING STACK]</span><br/>
          &bull; AI &amp; RAG:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;RAG (98%), LangChain (92%), Vector DB (94%), PyTorch (95%)<br/>
          &bull; Backend:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Python / FastAPI (96%), C# .NET Core (94%), BPMN (92%)<br/>
          &bull; FinTech:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Payment Gateways (98%), Iranian Sheba/IBAN (96%)<br/>
          &bull; Frontend:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Astro (96%), TypeScript (95%), Tailwind CSS (94%)<br/>
        `);
        break;

      case 'projects':
        appendLine(`
          <span class="text-[#f4d5cc] font-bold">[FEATURED WORK]</span><br/>
          1. thesis-rag: Advanced semantic chunking &amp; RAG retrieval.<br/>
          2. agah-platform: Distributed analytics &amp; telemetry.<br/>
          3. sheba-converter: Banking IBAN calculation &amp; routing engine.<br/>
          4. IAP-CafeBazar: Cryptographic in-app billing suite.<br/>
          Visit: <a href="https://github.com/saeedaliakbari4j" target="_blank" class="text-[#e07253] underline font-bold">github.com/saeedaliakbari4j</a>
        `);
        break;

      case 'rag':
        appendLine(`
          <span class="text-[#f4d5cc]">[EXECUTING RAG PIPELINE...]</span><br/>
          &gt; Embedding: dense 768-dim vector projected<br/>
          &gt; Cosine similarity in Chroma: <span class="text-[#e07253] font-bold">0.992</span><br/>
          &gt; Retrieved Chunk: "Saeed Aliakbari - 10+ yrs FinTech &amp; RAG Architect"<br/>
          &gt; Synthesis time: 44ms (zero hallucinations)
        `);
        break;

      case 'contact':
        appendLine(`
          <span class="text-[#f4d5cc] font-bold">[CONTACT INFO]</span><br/>
          &bull; Email:&nbsp;&nbsp;&nbsp;&nbsp;<a href="mailto:ai-bpmellat@outlook.com" class="text-[#e07253]">ai-bpmellat@outlook.com</a><br/>
          &bull; LinkedIn:&nbsp;<a href="https://www.linkedin.com/in/saeed-aliakbari/" target="_blank" class="text-[#e07253]">linkedin.com/in/saeed-aliakbari/</a><br/>
          &bull; GitHub:&nbsp;&nbsp;&nbsp;<a href="https://github.com/saeedaliakbari4j" target="_blank" class="text-[#e07253]">github.com/saeedaliakbari4j</a>
        `);
        break;

      case 'sudo hire':
        try {
          const confetti = (await import('canvas-confetti')).default;
          confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
        } catch(e) {}
        appendLine(`
          <span class="text-[#f4d5cc] font-bold">*** PARTNERSHIP PROTOCOL INITIATED ***</span><br/>
          Reach out directly via LinkedIn or email <a href="mailto:ai-bpmellat@outlook.com" class="text-[#e07253] underline font-bold">ai-bpmellat@outlook.com</a>.
        `);
        break;

      case 'clear':
        if (termBody) termBody.innerHTML = '';
        break;

      default:
        appendLine(`
          <span class="text-emerald-300">&gt; Query processed:</span> "${raw}"<br/>
          <span class="text-[#f4d5cc]">Saeed Aliakbari is a Senior Software Engineer &amp; AI Architect specializing in RAG architectures and banking-scale payment platforms. Type <span class="text-[#e07253] font-bold">help</span> for commands.</span>
        `);
        break;
    }
  }

  function handleSend() {
    if (!termInput) return;
    const val = termInput.value;
    if (val) {
      processCommand(val);
      termInput.value = '';
    }
  }

  submitBtn?.addEventListener('click', handleSend);
  termInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      handleSend();
    }
  });
</script>

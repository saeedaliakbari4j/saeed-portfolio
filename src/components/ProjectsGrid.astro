---
import { portfolioData, type ProjectItem } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { projects } = portfolioData;
---

<section id="projects" class="relative py-24 z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono border border-cyan-500/40 bg-cyan-950/30 text-cyan-300 mb-4">
          <span>03 // OPEN SOURCE & PRODUCTION REPOSITORIES</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          {isFa ? 'پروژه‌های شاخص و معماری‌های مهندسی' : 'Featured Projects & System Architectures'}
        </h2>
        <p class="mt-4 text-base text-slate-400 max-w-2xl">
          {isFa
            ? 'مجموعه‌ای از سامانه‌های هوش مصنوعی، خطوط لوله داده RAG، ابزارهای بانکی و فریم‌ورک‌های توسعه‌یافته توسط سعید علی‌اکبری با کدهای منبع در گیت‌هاب.'
            : 'Production systems, RAG data engines, banking protocol validators, and interactive applications built by Saeed Aliakbari.'}
        </p>
      </div>

      <!-- Filter Tabs -->
      <div class="flex flex-wrap items-center gap-1.5 p-1 rounded-2xl bg-slate-900 border border-slate-800 self-start md:self-auto">
        <button
          type="button"
          class="project-filter-btn px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all cursor-pointer bg-gradient-to-r from-cyan-500 to-sky-600 text-white shadow-sm"
          data-category="all"
        >
          {isFa ? 'همه پروژه‌ها' : 'All Projects'}
        </button>
        <button
          type="button"
          class="project-filter-btn px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all cursor-pointer text-slate-400 hover:text-white"
          data-category="ai"
        >
          AI & RAG
        </button>
        <button
          type="button"
          class="project-filter-btn px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all cursor-pointer text-slate-400 hover:text-white"
          data-category="fintech"
        >
          FinTech & Banking
        </button>
        <button
          type="button"
          class="project-filter-btn px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all cursor-pointer text-slate-400 hover:text-white"
          data-category="web"
        >
          Web & Tools
        </button>
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="projects-container">
      {projects.map((item) => (
        <article
          class="project-card glass-card rounded-3xl p-6 sm:p-7 border border-slate-800/90 hover:border-cyan-500/50 flex flex-col justify-between relative group"
          data-category={item.category}
        >
          <!-- Top Row: Badge & Category -->
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-[11px] font-mono px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-300">
                {isFa ? item.categoryLabelFa : item.categoryLabelEn}
              </span>
              {item.stats && (
                <span class="text-[11px] font-mono text-emerald-400 bg-emerald-950/40 border border-emerald-500/20 px-2.5 py-0.5 rounded-md">
                  {item.stats}
                </span>
              )}
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors mb-3">
              {isFa ? item.titleFa : item.titleEn}
            </h3>

            <!-- Description -->
            <p class="text-sm text-slate-300 leading-relaxed font-light mb-6">
              {isFa ? item.descFa : item.descEn}
            </p>

            <!-- Highlights -->
            <div class="mb-6 p-3 rounded-xl bg-slate-900/60 border border-slate-800/80 text-xs text-slate-400">
              <span class="text-cyan-400 font-mono text-[10px] block mb-1">
                {isFa ? 'ویژگی‌های کلیدی معماری:' : 'Architectural Highlights:'}
              </span>
              <span>{isFa ? item.highlightsFa : item.highlightsEn}</span>
            </div>
          </div>

          <!-- Bottom: Tech Tags & GitHub Button -->
          <div class="pt-4 border-t border-slate-800/80 flex flex-col gap-4">
            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5">
              {item.tags.map((t) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-300">
                  {t}
                </span>
              ))}
            </div>

            <!-- GitHub Repo Link Button -->
            <a
              href={item.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-between px-4 py-2.5 rounded-xl font-mono text-xs font-semibold text-slate-200 bg-slate-900/90 border border-slate-700/80 hover:border-cyan-400 hover:text-cyan-300 transition-all group/btn"
            >
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 fill-current text-slate-400 group-hover/btn:text-cyan-400" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                </svg>
                <span>{isFa ? 'مشاهده کدهای گیت‌هاب' : 'View Source on GitHub'}</span>
              </div>
              <svg class="w-3.5 h-3.5 rtl:rotate-180 text-slate-500 group-hover/btn:text-cyan-400 group-hover/btn:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  // Filter logic
  const filterBtns = document.querySelectorAll('.project-filter-btn');
  const cards = document.querySelectorAll('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const cat = target.getAttribute('data-category');

      // Update active button state
      filterBtns.forEach((b) => {
        b.className = 'project-filter-btn px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all cursor-pointer text-slate-400 hover:text-white';
      });
      target.className = 'project-filter-btn px-4 py-2 rounded-xl text-xs font-mono font-medium transition-all cursor-pointer bg-gradient-to-r from-cyan-500 to-sky-600 text-white shadow-sm';

      // Filter cards
      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (cat === 'all' || cardCat === cat) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

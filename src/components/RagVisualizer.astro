---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
---

<section id="rag-lab" class="py-14 sm:py-20 bg-[#f8fafc] border-b border-slate-200/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold tracking-wider uppercase mb-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        <span>{isFa ? 'آزمایشگاه زنده هوش مصنوعی' : 'LIVE AI ARCHITECTURE LAB'}</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">
        {isFa ? 'شبیه‌ساز زنده پایپ‌لاین RAG' : 'Interactive RAG Retrieval Simulator'}
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-slate-600">
        {isFa
          ? 'تخصص پیاده‌سازی سیستم‌های RAG و بازیابی هوشمند داده را در یک خط لوله بلادرنگ (Vector Search + Chunking + LLM) امتحان کنید.'
          : 'Experience production RAG architecture in real time: dense vector embedding, cosine similarity matching, and grounded context synthesis.'}
      </p>
    </div>

    <!-- RAG Interactive Console Container -->
    <div class="modern-card rounded-3xl p-5 sm:p-8 bg-white border border-slate-200 shadow-sm relative overflow-hidden">
      
      <!-- Top Title Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-200 text-xs font-mono">
        <div class="flex items-center gap-2 text-slate-800 font-bold">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span>RAG_PIPELINE // VECTOR_STORE: CHROMA // MODEL: LLM_GROUNDED</span>
        </div>
        <div class="flex items-center gap-2">
          <span id="rag-latency-badge" class="px-2.5 py-0.5 rounded-md bg-slate-100 border border-slate-200 text-slate-700 font-bold">
            LATENCY: IDLE
          </span>
          <span class="px-2.5 py-0.5 rounded-md bg-emerald-600 text-white font-bold">
            TOP-K: 1
          </span>
        </div>
      </div>

      <!-- Quick Preset Prompt Chips -->
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-slate-500">
          {isFa ? 'پرسش‌های پیشنهادی:' : 'Suggested Queries:'}
        </span>
        <button
          type="button"
          class="rag-query-chip text-xs px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:text-emerald-700 text-slate-700 font-medium transition-all cursor-pointer shadow-2xs"
          data-q={isFa ? 'تجربه سعید علی‌اکبری در سیستم‌های بانکی و به‌پرداخت ملت چیست؟' : 'What is his experience in banking & Behpardakht Mellat?'}
          data-ans={isFa 
            ? 'سعید علی‌اکبری در شرکت به‌پرداخت ملت (بزرگ‌ترین PSP خاورمیانه) معمار ارشد سیستم‌های BPM و راهکارهای هوش مصنوعی بوده و سامانه‌هایی با توان پردازش بیش از ۱۰ هزار تراکنش در ثانیه و الگوریتم‌های اعتبارسنجی شبکه شتاب و شبا را هدایت کرده است.'
            : 'At Behpardakht Mellat (the Middle East’s leading PSP), Saeed engineered high-throughput transaction engines handling 10k+ TPS, automated critical enterprise workflows via BPMN, and formulated banking-grade validation protocols.'}
          data-cos="0.987"
        >
          {isFa ? '🏦 سوابق بانکی و به‌پرداخت ملت' : '🏦 Banking & Behpardakht'}
        </button>

        <button
          type="button"
          class="rag-query-chip text-xs px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:text-emerald-700 text-slate-700 font-medium transition-all cursor-pointer shadow-2xs"
          data-q={isFa ? 'تخصص سعید در RAG و هوش مصنوعی مولد چیست؟' : 'What is his expertise in RAG & Generative AI?'}
          data-ans={isFa
            ? 'سعید علی‌اکبری در زمینه Retrieval-Augmented Generation و سیستم‌های هوش مصنوعی مولد متخصص است؛ او با بهره‌گیری از تکه‌بندی معنایی متون، پایگاه‌های برداری متراکم (Chroma/Milvus) و بازآرایی ترکیبی (Hybrid Rerank)، خطای توهم را در مدل‌های زبانی به زیر ۱٪ می‌رساند.'
            : 'Saeed specializes in production RAG systems, employing dense vector embeddings, semantic chunking, and cross-encoder reranking to minimize hallucinations in mission-critical LLM workflows.'}
          data-cos="0.994"
        >
          {isFa ? '🧠 معماری RAG و مدل‌های زبانی' : '🧠 RAG & Generative AI'}
        </button>

        <button
          type="button"
          class="rag-query-chip text-xs px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:text-emerald-700 text-slate-700 font-medium transition-all cursor-pointer shadow-2xs"
          data-q={isFa ? 'آیا سعید علی‌اکبری آماده همکاری و مشاوره در پروژه‌ها است؟' : 'Is Saeed available for leadership or consulting?'}
          data-ans={isFa
            ? 'بله، سعید علی‌اکبری با بیش از ۱۴ سال سابقه در طراحی نرم‌افزارهای سازمانی و هوش مصنوعی، آماده مشاوره معماری، پیاده‌سازی پایپ‌لاین‌های RAG و هدایت فنی پروژه‌ها است.'
            : 'Yes, Saeed brings 14+ years of software architecture experience and is open to AI consulting, RAG pipeline implementations, and engineering leadership.'}
          data-cos="0.981"
        >
          {isFa ? '💼 همکاری و مشاوره تخصصی' : '💼 Leadership & Consulting'}
        </button>
      </div>

      <!-- Input Row -->
      <div class="mt-3.5 flex flex-col sm:flex-row gap-2.5">
        <div class="relative flex-1">
          <input
            id="rag-input"
            type="text"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 focus:border-emerald-600 focus:bg-white text-xs sm:text-sm text-slate-900 font-medium transition-all outline-none"
            placeholder={isFa ? 'یک پرسش بنویسید یا دکمه‌های بالا را انتخاب کنید...' : 'Type a query or pick a preset question above...'}
            value={isFa ? 'تجربه سعید علی‌اکبری در سیستم‌های بانکی و به‌پرداخت ملت چیست؟' : 'What is his experience in banking & Behpardakht Mellat?'}
          />
        </div>
        <button
          id="rag-run-btn"
          type="button"
          class="px-6 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider text-white bg-emerald-600 hover:bg-emerald-700 transition-all shadow-xs cursor-pointer flex items-center justify-center gap-2 shrink-0"
        >
          <span id="rag-btn-spinner" class="hidden w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
          <span>{isFa ? 'اجرای پایپ‌لاین' : 'Execute RAG'}</span>
        </button>
      </div>

      <!-- Pipeline Step Visualizer (4 Compact Modern Cards) -->
      <div class="mt-5 grid grid-cols-2 md:grid-cols-4 gap-2.5">
        
        <!-- Step 1 -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200" id="step-embed">
          <div class="flex items-center justify-between text-[11px] font-mono mb-1.5">
            <span class="font-bold text-slate-800">01 // EMBED</span>
            <span class="step-status text-emerald-600 font-bold">READY</span>
          </div>
          <div class="text-[10px] font-mono text-slate-800 truncate h-6 flex items-center bg-white px-2 rounded border border-slate-200" id="embed-vector">
            [0.481, -0.192, ...]
          </div>
        </div>

        <!-- Step 2 -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200" id="step-cosine">
          <div class="flex items-center justify-between text-[11px] font-mono mb-1.5">
            <span class="font-bold text-slate-800">02 // MATCH</span>
            <span class="step-status text-emerald-600 font-bold">READY</span>
          </div>
          <div class="text-[10px] font-mono text-slate-800 h-6 flex items-center justify-between bg-white px-2 rounded border border-slate-200" id="cosine-score">
            <span>COSINE:</span>
            <span class="font-bold text-emerald-600">0.987</span>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200" id="step-chunk">
          <div class="flex items-center justify-between text-[11px] font-mono mb-1.5">
            <span class="font-bold text-slate-800">03 // CHUNK</span>
            <span class="step-status text-emerald-600 font-bold">READY</span>
          </div>
          <div class="text-[10px] font-mono text-slate-800 truncate h-6 flex items-center bg-white px-2 rounded border border-slate-200" id="chunk-snippet">
            DOC_BEHPARDAKHT_PSP
          </div>
        </div>

        <!-- Step 4 -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200" id="step-synth">
          <div class="flex items-center justify-between text-[11px] font-mono mb-1.5">
            <span class="font-bold text-slate-800">04 // SYNTH</span>
            <span class="step-status text-emerald-600 font-bold">READY</span>
          </div>
          <div class="text-[10px] font-mono text-slate-800 h-6 flex items-center justify-between bg-white px-2 rounded border border-slate-200" id="synth-status">
            <span>MODEL:</span>
            <span class="font-bold text-emerald-600">RAG_GROUND</span>
          </div>
        </div>

      </div>

      <!-- Output Display Box -->
      <div class="mt-4 p-4 sm:p-5 rounded-2xl bg-emerald-50/60 border border-emerald-200/80 relative">
        <div class="flex items-center justify-between text-xs font-bold text-emerald-900 mb-2 pb-1.5 border-b border-emerald-200">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            {isFa ? 'پاسخ مستند تولیدشده توسط پایپ‌لاین RAG:' : 'Synthesized Grounded Response:'}
          </span>
          <span class="text-[10px] text-slate-500 font-mono" id="tokens-counter">TOKENS: 0</span>
        </div>
        <p id="rag-output-text" class="text-slate-800 text-xs sm:text-sm leading-relaxed min-h-[3rem]">
          {isFa 
            ? 'سعید علی‌اکبری در شرکت به‌پرداخت ملت (بزرگ‌ترین PSP خاورمیانه) معمار ارشد سیستم‌های BPM و راهکارهای هوش مصنوعی بوده و سامانه‌هایی با توان پردازش بیش از ۱۰ هزار تراکنش در ثانیه و الگوریتم‌های اعتبارسنجی شبکه شتاب و شبا را هدایت کرده است.'
            : 'At Behpardakht Mellat (the Middle East’s leading PSP), Saeed engineered high-throughput transaction engines handling 10k+ TPS, automated critical enterprise workflows via BPMN, and formulated banking-grade validation protocols.'}
        </p>
      </div>

    </div>

  </div>
</section>

<script>
  const runBtn = document.getElementById('rag-run-btn');
  const spinner = document.getElementById('rag-btn-spinner');
  const input = document.getElementById('rag-input') as HTMLInputElement;
  const outputText = document.getElementById('rag-output-text');
  const latencyBadge = document.getElementById('rag-latency-badge');
  const embedVector = document.getElementById('embed-vector');
  const cosineScore = document.getElementById('cosine-score');
  const chunkSnippet = document.getElementById('chunk-snippet');
  const tokensCounter = document.getElementById('tokens-counter');

  let currentTargetAnswer = outputText?.textContent || '';
  let currentTargetCos = '0.987';

  document.querySelectorAll('.rag-query-chip').forEach((chip) => {
    chip.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const q = target.getAttribute('data-q') || '';
      const ans = target.getAttribute('data-ans') || '';
      const cos = target.getAttribute('data-cos') || '0.985';

      if (input) input.value = q;
      currentTargetAnswer = ans;
      currentTargetCos = cos;

      executePipeline();
    });
  });

  runBtn?.addEventListener('click', () => {
    executePipeline();
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      executePipeline();
    }
  });

  function executePipeline() {
    if (!outputText || !spinner) return;

    spinner.classList.remove('hidden');
    if (latencyBadge) latencyBadge.textContent = 'LATENCY: ...';

    outputText.textContent = '';
    if (tokensCounter) tokensCounter.textContent = 'TOKENS: 0';

    const randomVec = Array.from({ length: 3 }, () => (Math.random() * 2 - 1).toFixed(3));
    if (embedVector) embedVector.textContent = `[${randomVec.join(', ')}...]`;

    if (cosineScore) cosineScore.innerHTML = `<span>COS:</span><span class="font-bold text-emerald-600">${currentTargetCos}</span>`;

    if (chunkSnippet) {
      const snippets = ['DOC_BEHPARDAKHT_PSP', 'THESIS_RAG_PIPELINE', 'RAYAMATE_AI_SOLUTIONS'];
      chunkSnippet.textContent = snippets[Math.floor(Math.random() * snippets.length)];
    }

    const startTime = performance.now();

    setTimeout(() => {
      const elapsed = Math.round(performance.now() - startTime + 38);
      if (latencyBadge) latencyBadge.textContent = `LATENCY: ${elapsed}ms`;
      spinner.classList.add('hidden');

      let charIdx = 0;
      const textToType = currentTargetAnswer;

      const timer = setInterval(() => {
        if (charIdx < textToType.length) {
          outputText.textContent = textToType.slice(0, charIdx + 1);
          charIdx += 2;
          if (tokensCounter) tokensCounter.textContent = `TOKENS: ${Math.round(charIdx / 2.5)}`;
          if ((window as any).cyberAudio?.isEnabled?.()) {
            (window as any).cyberAudio.playKeyClick();
          }
        } else {
          outputText.textContent = textToType;
          clearInterval(timer);
        }
      }, 15);
    }, 400);
  }
</script>

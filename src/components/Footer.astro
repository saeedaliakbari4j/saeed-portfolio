---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { profile } = portfolioData;
---

<footer class="bg-[#1d4d3e] text-white py-14 border-t border-[#163d31] text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
    
    <!-- Left / Brand -->
    <div class="flex items-center gap-3">
      <span class="font-serif-vintage text-2xl font-bold text-white">
        {isFa ? 'سعید علی‌اکبری' : 'Saeed Aliakbari'}
      </span>
      <span class="text-emerald-300">/</span>
      <span class="text-emerald-200">
        AI ARCHITECT &amp; SOFTWARE ENGINEER &copy; {new Date().getFullYear()}
      </span>
    </div>

    <!-- Center: Tech Stack Badge -->
    <div class="text-xs text-emerald-200 flex items-center gap-2">
      <span>BUILT WITH</span>
      <span class="px-2.5 py-1 rounded bg-[#143a2e] border border-[#276652] text-[#f4d5cc] font-bold">
        ASTRO 7
      </span>
      <span>&amp;</span>
      <span class="px-2.5 py-1 rounded bg-[#143a2e] border border-[#276652] text-[#f4d5cc] font-bold">
        TAILWIND
      </span>
    </div>

    <!-- Right: Back to Top & Socials -->
    <div class="flex items-center gap-6 font-bold uppercase tracking-wider text-xs">
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="text-emerald-200 hover:text-white transition-colors">
        GitHub
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="text-emerald-200 hover:text-white transition-colors">
        LinkedIn
      </a>
      <a href={`mailto:${profile.email}`} class="text-emerald-200 hover:text-white transition-colors">
        Email
      </a>
      <a
        href="#home"
        class="p-2.5 rounded-lg bg-[#143a2e] border border-[#276652] hover:bg-[#e07253] hover:border-[#e07253] text-white transition-all"
        title={isFa ? 'بازگشت به بالا' : 'Back to Top'}
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
        </svg>
      </a>
    </div>

  </div>
</footer>

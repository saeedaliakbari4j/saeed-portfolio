---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { profile, stats } = portfolioData;
---

<section id="about" class="py-12 sm:py-16 bg-white border-b border-[#e5efe9]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      
      <!-- Left Column: Story -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        
        <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#eef7f4] border border-[#cbe4db] text-[#1d4d3e] text-[11px] font-bold tracking-wider uppercase w-fit">
          <span>{isFa ? 'درباره من و مسیر حرفه‌ای' : 'ABOUT & BACKGROUND'}</span>
        </div>

        <h2 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-[#1d4d3e] leading-snug font-vintage">
          {isFa
            ? 'پیوند زدن علم داده و هوش مصنوعی با سامانه‌های بانکی با ضریب اطمینان ۹۹.۹٪'
            : 'Bridging Advanced AI & RAG with Mission-Critical Banking Engines'}
        </h2>

        <p class="text-xs sm:text-sm text-[#3d594f] leading-relaxed font-normal">
          {isFa ? profile.bioFa : profile.bioEn}
        </p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-[#e2ece7]">
          {stats.map((s) => (
            <div class="bg-[#faf8f5] rounded-xl p-3 border border-[#e2ece7] text-center">
              <div class="text-2xl sm:text-3xl font-black text-[#d96245] font-vintage">{s.value}</div>
              <div class="text-[10px] text-[#5a7369] font-medium mt-0.5">
                {isFa ? s.labelFa : s.labelEn}
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Right Column: Highlight Card -->
      <div class="lg:col-span-5">
        <div class="bg-[#1d4d3e] text-white rounded-2xl p-6 sm:p-7 shadow-lg relative overflow-hidden">
          
          <div class="text-[10px] font-mono text-[#f4d5cc] uppercase tracking-widest mb-3">
            {isFa ? 'اصول مهندسی نرم‌افزار' : 'ENGINEERING PRINCIPLES'}
          </div>

          <h3 class="text-lg font-bold text-white mb-4 leading-snug font-vintage">
            {isFa
              ? '«ساختن سیستم‌هایی که در لود بالا پایدارند، کمترین خطای انسانی دارند و کار با آن‌ها لذت‌بخش است.»'
              : '"Building resilient architectures that scale smoothly with zero downtime and intuitive design."'}
          </h3>

          <ul class="space-y-3 text-xs text-emerald-100 font-normal border-t border-[#276652] pt-4">
            <li class="flex items-start gap-2">
              <span class="text-[#d96245] font-bold text-sm leading-none">✓</span>
              <span>{isFa ? 'بیش از ۱۰ سال تجربه کار با Python، C# .NET و وب مدرن' : '10+ years in Python, C# .NET Core, and modern web architectures'}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#d96245] font-bold text-sm leading-none">✓</span>
              <span>{isFa ? 'پژوهش‌های تز ارشد در زمینه RAG و بازیابی معنایی در دانشگاه شهید بهشتی' : 'M.Sc. research on RAG pipelines & semantic vector retrieval at Shahid Beheshti Univ.'}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#d96245] font-bold text-sm leading-none">✓</span>
              <span>{isFa ? 'رهبری فنی در رایامیت و توسعه سامانه‌های بانکی در به‌پرداخت ملت' : 'Technical leadership at Rayamate & transaction systems at Behpardakht Mellat'}</span>
            </li>
          </ul>

          <div class="mt-6 pt-4 border-t border-[#276652] flex items-center justify-between text-xs">
            <span class="text-emerald-200 text-[11px]">
              {isFa ? 'محل سکونت:' : 'Location:'} <strong>{isFa ? profile.locationFa : profile.locationEn}</strong>
            </span>
            <a
              href="#contact"
              class="text-[11px] font-bold uppercase tracking-wider text-[#f4d5cc] hover:text-white underline underline-offset-2"
            >
              {isFa ? 'ارتباط مستقیم ←' : 'Get in touch →'}
            </a>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

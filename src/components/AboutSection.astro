---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { profile, stats } = portfolioData;
---

<section id="about" class="py-14 sm:py-20 bg-white border-b border-slate-200/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Story -->
      <div class="lg:col-span-7 flex flex-col gap-5">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-800 text-xs font-bold tracking-wider uppercase w-fit">
          <span>{isFa ? 'درباره من و مسیر حرفه‌ای' : 'About & Background'}</span>
        </div>

        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 leading-snug">
          {isFa
            ? 'تلفیق هوش مصنوعی مولد با زیرساخت‌های کلان بانکی با قابلیت اطمینان ۹۹.۹٪'
            : 'Bridging Generative AI & RAG with Mission-Critical Banking Engines'}
        </h2>

        <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
          {isFa ? profile.bioFa : profile.bioEn}
        </p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 pt-4 border-t border-slate-200">
          {stats.map((s) => (
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/90 text-center">
              <div class="text-2xl sm:text-3xl font-black text-emerald-700">{s.value}</div>
              <div class="text-[11px] text-slate-600 font-medium mt-0.5 leading-tight">
                {isFa ? s.labelFa : s.labelEn}
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Right Column: Engineering Principles Card -->
      <div class="lg:col-span-5">
        <div class="modern-card rounded-3xl p-6 sm:p-8 bg-slate-900 text-white shadow-xl relative overflow-hidden">
          
          <div class="text-xs font-mono text-emerald-400 uppercase tracking-widest mb-3">
            {isFa ? 'فلسفه و چشم‌انداز مهندسی' : 'ENGINEERING PHILOSOPHY'}
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-white mb-5 leading-snug">
            {isFa
              ? '«ساختن سیستم‌هایی که در ترافیک‌های سنگین بدون افت کارایی پایدارند و هوش مصنوعی را به ابزاری مولد برای کسب‌وکار تبدیل می‌کنند.»'
              : '"Building robust software architectures that withstand massive traffic loads while translating AI into production value."'}
          </h3>

          <ul class="space-y-3.5 text-xs text-slate-300 font-normal border-t border-slate-800 pt-5">
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold text-sm leading-none">✓</span>
              <span>{isFa ? 'بیش از ۱۴ سال سابقه در C# .NET Core، پایتون و سیستم‌های توزیع‌شده' : '14+ years in C# .NET Core, Python, and distributed enterprise systems'}</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold text-sm leading-none">✓</span>
              <span>{isFa ? 'فارغ‌التحصیل کارشناسی ارشد مهندسی کامپیوتر از دانشگاه شهید بهشتی' : 'M.Sc. in Computer Engineering & Software Systems from Shahid Beheshti Univ.'}</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold text-sm leading-none">✓</span>
              <span>{isFa ? 'توسعه سامانه‌های پردازش تراکنش با لود بالا در به‌پرداخت ملت (PSP)' : 'Engineering high-throughput transaction engines at Behpardakht Mellat'}</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold text-sm leading-none">✓</span>
              <span>{isFa ? 'طراحی و پیاده‌سازی سیستم‌های RAG و مدل‌های هوش مصنوعی در رایامیت' : 'Architecting production RAG & Generative AI pipelines at Rayamate'}</span>
            </li>
          </ul>

          <div class="mt-6 pt-5 border-t border-slate-800 flex items-center justify-between text-xs">
            <span class="text-slate-400 text-[11px]">
              {isFa ? 'محل فعالیت:' : 'Location:'} <strong class="text-white">{isFa ? profile.locationFa : profile.locationEn}</strong>
            </span>
            <a
              href="#contact"
              class="text-[11px] font-bold text-emerald-400 hover:text-emerald-300 underline underline-offset-4"
            >
              {isFa ? 'گفتگو درباره پروژه ←' : 'Start a discussion →'}
            </a>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { profile } = portfolioData;
---

<section id="home" class="py-6 sm:py-10 bg-[#faf8f5]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Contained Hero Card: Clean, elegant, proportional -->
    <div class="bg-white rounded-3xl border border-[#e2ece7] shadow-lg overflow-hidden grid grid-cols-1 md:grid-cols-12 items-stretch">
      
      <!-- Text Column (Col 7) -->
      <div class="md:col-span-7 bg-[#eef7f4] p-6 sm:p-10 lg:p-12 flex flex-col justify-center order-2 md:order-1">
        
        <!-- Coral Greeting -->
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#d96245] tracking-tight leading-tight mb-4 font-vintage">
          {isFa ? 'سلام! من سعید هستم.' : "Hi! I'm Saeed Aliakbari."}
        </h1>

        <!-- Subheading / Bio with Editorial Underlines -->
        <div class="text-sm sm:text-base lg:text-lg text-[#1d4d3e] leading-relaxed mb-6 font-medium">
          {isFa ? (
            <p>
              من یک <span class="editorial-underline font-bold text-[#14382d]">مهندس ارشد نرم‌افزار</span> و <span class="editorial-underline font-bold text-[#14382d]">معمار هوش مصنوعی</span> با بیش از ۱۰ سال سابقه در توسعه سیستم‌های بانکی به‌پرداخت ملت هستم که عاشق طراحی <span class="editorial-underline font-bold text-[#14382d]">خطوط لوله پیشرفته RAG</span> و ساخت سامانه‌های وب مقیاس‌پذیرم.
            </p>
          ) : (
            <p>
              I'm a <span class="editorial-underline font-bold text-[#14382d]">lead software engineer</span> &amp; <span class="editorial-underline font-bold text-[#14382d]">AI architect</span> with a knack for high-scale FinTech systems who loves engineering <span class="editorial-underline font-bold text-[#14382d]">intelligent RAG pipelines</span> and building resilient web platforms.
            </p>
          )}
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="#about"
            class="inline-flex items-center justify-center bg-[#d96245] hover:bg-[#c45237] text-white font-bold text-xs tracking-wider uppercase px-5 py-2.5 rounded-lg shadow-sm hover:shadow transition-all"
          >
            {isFa ? 'بیشتر بدانید!' : 'TELL ME MORE!'}
          </a>

          <a
            href="#rag-lab"
            class="inline-flex items-center justify-center bg-white border border-[#1d4d3e] text-[#1d4d3e] hover:bg-[#1d4d3e] hover:text-white font-bold text-xs tracking-wider uppercase px-4 py-2.5 rounded-lg transition-all"
          >
            {isFa ? 'آزمایشگاه RAG' : 'EXPLORE AI LAB'}
          </a>
        </div>

      </div>

      <!-- Photo Column (Col 5) -->
      <div class="md:col-span-5 bg-[#f6eee5] p-6 sm:p-8 flex items-center justify-center order-1 md:order-2 relative overflow-hidden">
        <!-- Subtle organic backdrop doodle -->
        <div class="absolute -right-8 -bottom-8 w-48 h-48 rounded-full bg-[#ebdcd0] opacity-50 pointer-events-none"></div>
        <div class="absolute -left-8 -top-8 w-40 h-40 rounded-full bg-[#dcece6] opacity-50 pointer-events-none"></div>

        <div class="relative z-10 w-full max-w-[260px] sm:max-w-[290px] aspect-[4/5] rounded-2xl overflow-hidden shadow-md border-2 border-white bg-white group">
          <img
            src={profile.avatarUrl}
            alt={isFa ? profile.nameFa : profile.nameEn}
            class="w-full h-full object-cover object-center group-hover:scale-103 transition-transform duration-500"
            loading="eager"
          />
          <!-- Badge in corner -->
          <div class="absolute bottom-2.5 start-2.5 end-2.5 bg-white/95 backdrop-blur-xs px-3 py-1.5 rounded-lg shadow-xs border border-[#e2ece7] text-center">
            <span class="text-xs font-bold text-[#1d4d3e] block leading-tight">
              {isFa ? profile.nameFa : profile.nameEn}
            </span>
            <span class="text-[10px] text-[#d96245] font-semibold">
              {isFa ? 'معمار هوش مصنوعی و سیستم‌های بانکی' : 'AI Architect & Software Engineer'}
            </span>
          </div>
        </div>
      </div>

    </div>

    <!-- Specializing Subtitle & Partner Logos Ribbon -->
    <div class="mt-8 pt-6 border-t border-[#e2ece7] text-center">
      <h2 class="text-sm sm:text-base font-bold text-[#1d4d3e] mb-4 font-vintage">
        {isFa
          ? 'تخصص ویژه در سیستم‌های RAG، معماری سامانه‌های بانکی و توسعه نرم‌افزار'
          : 'Specializing in RAG Systems, FinTech Platforms, and AI Architecture'}
      </h2>

      <!-- Ribbon of Brands / Tech Logos -->
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs font-semibold text-[#5a7369]">
        <div class="flex items-center gap-1.5 hover:text-[#1d4d3e] transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-[#d96245]"></span>
          <span>{isFa ? 'به‌پرداخت ملت' : 'Behpardakht Mellat'}</span>
        </div>
        <div class="flex items-center gap-1.5 hover:text-[#1d4d3e] transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-[#1d4d3e]"></span>
          <span>{isFa ? 'دانشگاه شهید بهشتی' : 'Shahid Beheshti Univ.'}</span>
        </div>
        <div class="flex items-center gap-1.5 hover:text-[#1d4d3e] transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-[#d96245]"></span>
          <span>{isFa ? 'رایامیت' : 'Rayamate'}</span>
        </div>
        <div class="flex items-center gap-1.5 hover:text-[#1d4d3e] transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-[#1d4d3e]"></span>
          <span>Python &amp; PyTorch</span>
        </div>
        <div class="flex items-center gap-1.5 hover:text-[#1d4d3e] transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-[#d96245]"></span>
          <span>LangChain &amp; RAG</span>
        </div>
        <div class="flex items-center gap-1.5 hover:text-[#1d4d3e] transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-[#1d4d3e]"></span>
          <span>Astro Framework</span>
        </div>
      </div>
    </div>

  </div>
</section>

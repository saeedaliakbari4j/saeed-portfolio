---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { profile } = portfolioData;
---

<section id="home" class="relative bg-white border-b border-[#e5efe9]">
  
  <!-- Split Hero: Photo on Left, Mint Box on Right (in LTR) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[580px] lg:min-h-[640px]">
    
    <!-- Photo Column (Left in LTR, Right in RTL) -->
    <div class="relative bg-[#f5ede4] flex items-center justify-center p-8 sm:p-12 overflow-hidden group">
      <!-- Decorative Retro Background Shapes like the mural in reference -->
      <div class="absolute inset-0 opacity-20 pointer-events-none">
        <svg class="w-full h-full" viewBox="0 0 400 400" preserveAspectRatio="none">
          <path d="M0,100 C150,200 250,0 400,100 L400,400 L0,400 Z" fill="#e07253" />
          <path d="M0,250 C120,180 280,320 400,220 L400,400 L0,400 Z" fill="#1d4d3e" opacity="0.3" />
        </svg>
      </div>

      <div class="relative z-10 w-full max-w-md aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl border-4 border-white bg-white">
        <img
          src={profile.avatarUrl}
          alt={isFa ? profile.nameFa : profile.nameEn}
          class="w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-700"
          loading="eager"
        />
        <!-- Small Vintage Label Badge -->
        <div class="absolute bottom-4 start-4 bg-white/95 backdrop-blur-sm px-4 py-2 rounded-lg shadow-md border border-[#e2ece7]">
          <span class="text-xs font-bold text-[#1d4d3e] block">
            {isFa ? profile.nameFa : profile.nameEn}
          </span>
          <span class="text-[11px] text-[#e07253] font-medium">
            {isFa ? 'معمار هوش مصنوعی و مهندس نرم‌افزار' : 'AI Architect & Software Engineer'}
          </span>
        </div>
      </div>
    </div>

    <!-- Mint Greeting Box (Right in LTR, Left in RTL) -->
    <div class="bg-[#e8f5f1] p-8 sm:p-14 lg:p-16 xl:p-20 flex flex-col justify-center">
      
      <!-- Coral Greeting Serif -->
      <h1 class="font-serif-vintage text-3xl sm:text-5xl lg:text-5xl xl:text-6xl font-bold text-[#e07253] tracking-tight leading-[1.2] mb-6">
        {isFa ? 'سلام! من سعید هستم.' : "Hi! I'm Saeed Aliakbari."}
      </h1>

      <!-- Subheading / Bio with Editorial Underlines -->
      <div class="font-serif-vintage text-xl sm:text-2xl lg:text-3xl text-[#1d4d3e] leading-[1.4] mb-8 font-normal">
        {isFa ? (
          <p>
            من یک <span class="editorial-underline font-bold">مهندس ارشد نرم‌افزار</span> و <span class="editorial-underline font-bold">معمار هوش مصنوعی</span> با بیش از ۱۰ سال سابقه در توسعه سیستم‌های بانکی به‌پرداخت ملت هستم که عاشق طراحی <span class="editorial-underline font-bold">خطوط لوله پیشرفته RAG</span> و ساخت سامانه‌های وب مقیاس‌پذیرم.
          </p>
        ) : (
          <p>
            I'm a <span class="editorial-underline font-bold">lead software engineer</span> &amp; <span class="editorial-underline font-bold">AI architect</span> with a knack for high-scale FinTech systems who loves engineering <span class="editorial-underline font-bold">intelligent RAG pipelines</span> and building resilient web platforms.
          </p>
        )}
      </div>

      <!-- Action Button & Link (Terracotta Coral block button matching reference) -->
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#about"
          class="inline-block bg-[#e07253] hover:bg-[#cb5e40] text-white font-bold text-xs sm:text-sm tracking-wider uppercase px-8 py-4 shadow-md hover:shadow-lg transition-all text-center"
        >
          {isFa ? 'بیشتر بدانید!' : 'TELL ME MORE!'}
        </a>

        <a
          href="#rag-lab"
          class="inline-block border-2 border-[#1d4d3e] text-[#1d4d3e] hover:bg-[#1d4d3e] hover:text-white font-bold text-xs sm:text-sm tracking-wider uppercase px-6 py-3.5 transition-all text-center"
        >
          {isFa ? 'آزمایشگاه RAG' : 'EXPLORE AI LAB'}
        </a>
      </div>

    </div>

  </div>

  <!-- Specializing Subtitle & Partners/Clients Logo Ribbon (Exact match to reference bottom) -->
  <div class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Serif Centered Subtitle -->
      <h2 class="font-serif-vintage text-2xl sm:text-3xl font-bold text-[#1d4d3e] mb-10">
        {isFa
          ? 'تخصص ویژه در سیستم‌های RAG، معماری سامانه‌های بانکی و توسعه نرم‌افزار'
          : 'Specializing in RAG Systems, FinTech Platforms, and AI Architecture'}
      </h2>

      <!-- Ribbon of Brands / Tech Logos -->
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-14 opacity-80 grayscale hover:grayscale-0 transition-all">
        
        <!-- Behpardakht Mellat -->
        <div class="flex items-center gap-2 text-[#1d4d3e] font-serif-vintage font-bold text-base sm:text-lg">
          <span class="w-3 h-3 rounded-full bg-[#e07253]"></span>
          <span>{isFa ? 'به‌پرداخت ملت' : 'Behpardakht Mellat PSP'}</span>
        </div>

        <!-- Shahid Beheshti University -->
        <div class="flex items-center gap-2 text-[#1d4d3e] font-serif-vintage font-bold text-base sm:text-lg">
          <span class="w-3 h-3 rounded-full bg-[#1d4d3e]"></span>
          <span>{isFa ? 'دانشگاه شهید بهشتی' : 'Shahid Beheshti Univ.'}</span>
        </div>

        <!-- Rayamate -->
        <div class="flex items-center gap-2 text-[#1d4d3e] font-serif-vintage font-bold text-base sm:text-lg">
          <span class="w-3 h-3 rounded-full bg-[#e07253]"></span>
          <span>{isFa ? 'رایامیت' : 'Rayamate'}</span>
        </div>

        <!-- Python & PyTorch -->
        <div class="flex items-center gap-2 text-[#1d4d3e] font-serif-vintage font-bold text-base sm:text-lg">
          <span class="w-3 h-3 rounded-full bg-[#1d4d3e]"></span>
          <span>Python &amp; PyTorch</span>
        </div>

        <!-- LangChain & RAG -->
        <div class="flex items-center gap-2 text-[#1d4d3e] font-serif-vintage font-bold text-base sm:text-lg">
          <span class="w-3 h-3 rounded-full bg-[#e07253]"></span>
          <span>LangChain &amp; RAG</span>
        </div>

        <!-- Astro & Web -->
        <div class="flex items-center gap-2 text-[#1d4d3e] font-serif-vintage font-bold text-base sm:text-lg">
          <span class="w-3 h-3 rounded-full bg-[#1d4d3e]"></span>
          <span>Astro Framework</span>
        </div>

      </div>

    </div>
  </div>

</section>

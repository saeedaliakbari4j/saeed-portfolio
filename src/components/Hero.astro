---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { profile, stats } = portfolioData;
---

<section id="about" class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left / Main Text Column -->
      <div class="lg:col-span-7 flex flex-col gap-6 text-center lg:text-start order-2 lg:order-1">
        
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-cyan-500/30 bg-cyan-950/20 backdrop-blur-md w-fit mx-auto lg:mx-0 shadow-lg shadow-cyan-950/50">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          <span class="text-xs font-mono text-cyan-300 tracking-wide">
            {isFa ? profile.availabilityFa : profile.availabilityEn}
          </span>
        </div>

        <!-- Name & Main Title -->
        <div class="flex flex-col gap-3">
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.15]">
            {isFa ? profile.nameFa : profile.nameEn}
          </h1>
          <div class="text-xl sm:text-2xl lg:text-3xl font-semibold text-gradient-cyan">
            {isFa ? profile.roleFa : profile.roleEn}
          </div>
        </div>

        <!-- Bio Paragraph -->
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto lg:mx-0 font-light">
          {isFa ? profile.bioFa : profile.bioEn}
        </p>

        <!-- Highlights / Tech Tag Badges -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 pt-2">
          <span class="px-3 py-1 rounded-lg text-xs font-mono bg-cyan-950/40 border border-cyan-500/30 text-cyan-300">
            #RetrievalAugmentedGeneration
          </span>
          <span class="px-3 py-1 rounded-lg text-xs font-mono bg-sky-950/40 border border-sky-500/30 text-sky-300">
            #FinTechArchitecture
          </span>
          <span class="px-3 py-1 rounded-lg text-xs font-mono bg-indigo-950/40 border border-indigo-500/30 text-indigo-300">
            #LLMAgents
          </span>
          <span class="px-3 py-1 rounded-lg text-xs font-mono bg-emerald-950/40 border border-emerald-500/30 text-emerald-300">
            #BPM & HighThroughput
          </span>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-4">
          <a
            href="#rag-lab"
            class="relative inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm text-slate-950 bg-gradient-to-r from-cyan-400 via-sky-400 to-teal-300 hover:from-cyan-300 hover:to-teal-200 shadow-lg shadow-cyan-500/25 hover:shadow-cyan-400/40 hover:-translate-y-0.5 transition-all cursor-pointer"
          >
            <span>{isFa ? 'ورود به آزمایشگاه RAG' : 'Launch RAG Lab'}</span>
            <svg class="w-4 h-4 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <button
            id="hero-terminal-btn"
            type="button"
            class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl font-mono text-sm font-semibold text-cyan-300 bg-slate-900/80 border border-cyan-500/40 hover:border-cyan-400 hover:bg-cyan-950/30 hover:-translate-y-0.5 transition-all cursor-pointer shadow-lg shadow-slate-950/50"
          >
            <span class="text-cyan-400 font-bold">~</span>
            <span>{isFa ? 'کنسول تعاملی هوش مصنوعی' : 'Interactive Terminal'}</span>
          </button>

          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 p-3.5 rounded-xl text-slate-400 hover:text-white bg-slate-900/60 border border-slate-800 hover:border-slate-700 hover:-translate-y-0.5 transition-all"
            title="GitHub"
            aria-label="GitHub Profile"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
          </a>

          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 p-3.5 rounded-xl text-slate-400 hover:text-sky-400 bg-slate-900/60 border border-slate-800 hover:border-sky-500/40 hover:-translate-y-0.5 transition-all"
            title="LinkedIn"
            aria-label="LinkedIn Profile"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>
        </div>

        <!-- Metric Stat Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-slate-800/80">
          {stats.map((s) => (
            <div class="glass-card rounded-xl p-3 text-center border-slate-800/80 hover:border-cyan-500/40">
              <div class="text-2xl font-extrabold font-mono text-cyan-300">{s.value}</div>
              <div class="text-[11px] text-slate-400 mt-1 leading-tight">
                {isFa ? s.labelFa : s.labelEn}
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Right Column: Saeed's Holographic 3D Photo Card -->
      <div class="lg:col-span-5 flex justify-center order-1 lg:order-2">
        <div class="relative w-full max-w-sm" id="hero-card-container">
          
          <!-- Outer Ambient Glows -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-cyan-500 via-sky-500 to-indigo-600 opacity-40 blur-2xl animate-pulse"></div>
          
          <!-- Card Body with 3D Tilt -->
          <div 
            id="hero-3d-card"
            class="relative rounded-3xl p-4 bg-slate-950/80 border border-cyan-500/30 shadow-2xl backdrop-blur-2xl transition-transform duration-200 ease-out overflow-hidden"
          >
            <!-- Scanline Laser Effect -->
            <div class="scanline"></div>

            <!-- Header of Holographic Card -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-800/80 text-[11px] font-mono text-cyan-400">
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                <span>SYSTEM://ACTIVE</span>
              </div>
              <span>BEHPARDAKHT // RAYAMATE</span>
            </div>

            <!-- Profile Picture Box -->
            <div class="relative mt-3 rounded-2xl overflow-hidden aspect-[4/5] bg-slate-900 border border-slate-800/90 group">
              <img
                src={profile.avatarUrl}
                alt={isFa ? profile.nameFa : profile.nameEn}
                class="w-full h-full object-cover object-center filter saturate-105 contrast-105 group-hover:scale-105 transition-transform duration-500"
                loading="eager"
              />
              
              <!-- Subtle Cyber Grid Vignette -->
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
              
              <!-- Floating Corner Cyber Markers -->
              <div class="absolute top-3 left-3 w-3 h-3 border-t-2 border-l-2 border-cyan-400"></div>
              <div class="absolute top-3 right-3 w-3 h-3 border-t-2 border-r-2 border-cyan-400"></div>
              <div class="absolute bottom-3 left-3 w-3 h-3 border-b-2 border-l-2 border-cyan-400"></div>
              <div class="absolute bottom-3 right-3 w-3 h-3 border-b-2 border-r-2 border-cyan-400"></div>

              <!-- Floating Bottom Badge inside image -->
              <div class="absolute bottom-4 left-4 right-4 p-3 rounded-xl bg-slate-950/85 backdrop-blur-md border border-cyan-500/30">
                <div class="text-xs font-bold text-white flex items-center justify-between">
                  <span>{isFa ? profile.nameFa : profile.nameEn}</span>
                  <span class="text-[10px] font-mono text-cyan-400 bg-cyan-950/60 px-2 py-0.5 rounded-md border border-cyan-500/30">
                    SBU ALUMNUS
                  </span>
                </div>
                <div class="text-[11px] text-slate-400 font-mono mt-0.5">
                  {isFa ? 'دانشگاه شهید بهشتی // علوم کامپیوتر' : 'Shahid Beheshti Univ. // CS'}
                </div>
              </div>
            </div>

            <!-- Footer Telemetry -->
            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] font-mono text-slate-400">
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>STATUS: ONLINE</span>
              </div>
              <span class="text-cyan-400">RAG // LATENCY: 84ms</span>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // 3D Parallax Tilt for Hero Card
  const cardContainer = document.getElementById('hero-card-container');
  const card = document.getElementById('hero-3d-card');

  if (cardContainer && card) {
    cardContainer.addEventListener('mousemove', (e) => {
      const rect = cardContainer.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;

      const rotateX = (-y / rect.height) * 16;
      const rotateY = (x / rect.width) * 16;

      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
    });

    cardContainer.addEventListener('mouseleave', () => {
      card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
    });
  }

  // Terminal trigger button in hero
  const heroTerminalBtn = document.getElementById('hero-terminal-btn');
  heroTerminalBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-terminal'));
  });
</script>

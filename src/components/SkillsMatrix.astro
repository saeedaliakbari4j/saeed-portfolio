---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { skillCategories } = portfolioData;
---

<section id="skills" class="relative py-24 z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono border border-sky-500/40 bg-sky-950/30 text-sky-300 mb-4">
        <span>02 // CAPABILITIES MATRIX</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        {isFa ? 'ماتریس تخصصی و توانمندی‌های مهندسی' : 'Engineering Matrix & Technical Mastery'}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-400">
        {isFa
          ? 'بیش از یک دهه تجربه در تلاقی مهندسی سیستم‌های پرسرعت، بانکداری نوین و مدل‌های پیشرفته هوش مصنوعی.'
          : 'A decade of battle-tested engineering at the crossroads of low-latency systems, next-gen FinTech, and state-of-the-art AI.'}
      </p>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {skillCategories.map((cat, idx) => (
        <div class="glass-card rounded-3xl p-6 sm:p-8 border border-slate-800 hover:border-cyan-500/40 relative group">
          
          <!-- Category Header -->
          <div class="flex items-center justify-between pb-6 mb-6 border-b border-slate-800/80">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500/20 to-sky-500/20 border border-cyan-500/30 flex items-center justify-center text-cyan-400 font-mono text-sm font-bold">
                0{idx + 1}
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-white group-hover:text-cyan-300 transition-colors">
                {isFa ? cat.titleFa : cat.titleEn}
              </h3>
            </div>
            <span class="text-xs font-mono text-slate-500">SYS_LVL: PRO</span>
          </div>

          <!-- Skill Items with Progress Bars -->
          <div class="flex flex-col gap-5">
            {cat.items.map((skill) => (
              <div class="flex flex-col gap-1.5">
                <div class="flex items-center justify-between text-xs sm:text-sm">
                  <span class="font-medium text-slate-200">{skill.name}</span>
                  <span class="font-mono text-cyan-400 text-xs font-semibold">{skill.level}%</span>
                </div>
                
                <!-- Progress Bar Track -->
                <div class="h-2 w-full rounded-full bg-slate-900 overflow-hidden p-[1px] border border-slate-800">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-cyan-400 via-sky-400 to-indigo-500 shadow-sm shadow-cyan-400/50"
                    style={`width: ${skill.level}%`}
                  ></div>
                </div>

                <!-- Note description -->
                <span class="text-[11px] text-slate-400 font-light">
                  {isFa ? skill.noteFa : skill.noteEn}
                </span>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

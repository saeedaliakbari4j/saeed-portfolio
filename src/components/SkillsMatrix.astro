---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { skillCategories } = portfolioData;
---

<section id="skills" class="py-14 sm:py-16 bg-white border-b border-[#e5efe9]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#eef7f4] border border-[#cbe4db] text-[#1d4d3e] text-[11px] font-bold tracking-wider uppercase mb-2">
        <span>CORE CAPABILITIES</span>
      </div>
      <h2 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-[#1d4d3e] tracking-tight font-vintage">
        {isFa ? 'ماتریس تخصصی و توانمندی‌های مهندسی' : 'Technical Mastery & Core Domains'}
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-[#5a7369]">
        {isFa
          ? 'بیش از یک دهه تجربه در تلاقی سیستم‌های پرسرعت، بانکداری نوین و مدل‌های پیشرفته هوش مصنوعی.'
          : 'A decade of battle-tested engineering at the crossroads of low-latency systems, next-gen FinTech, and AI.'}
      </p>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
      {skillCategories.map((cat, idx) => (
        <div class="editorial-card rounded-2xl p-5 sm:p-6 relative group">
          
          <!-- Category Header -->
          <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-[#e2ece7]">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-[#eef7f4] border border-[#cbe4db] flex items-center justify-center text-[#1d4d3e] font-bold text-xs">
                0{idx + 1}
              </div>
              <h3 class="text-base sm:text-lg font-bold text-[#1d4d3e] group-hover:text-[#d96245] transition-colors font-vintage">
                {isFa ? cat.titleFa : cat.titleEn}
              </h3>
            </div>
            <span class="text-[10px] font-bold text-[#d96245] bg-[#fbf0ec] px-2 py-0.5 rounded-md">
              EXPERT
            </span>
          </div>

          <!-- Skill Items -->
          <div class="flex flex-col gap-3.5">
            {cat.items.map((skill) => (
              <div class="flex flex-col gap-1">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-bold text-[#192b23]">{skill.name}</span>
                  <span class="font-mono font-bold text-[#d96245] text-xs">{skill.level}%</span>
                </div>
                
                <div class="h-2 w-full rounded-full bg-[#eef7f4] overflow-hidden p-[1px] border border-[#d2e8df]">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-[#d96245] to-[#f2967e]"
                    style={`width: ${skill.level}%`}
                  ></div>
                </div>

                <span class="text-[10px] text-[#5a7369] font-normal">
                  {isFa ? skill.noteFa : skill.noteEn}
                </span>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

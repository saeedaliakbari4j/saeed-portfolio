---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { skillCategories } = portfolioData;
---

<section id="skills" class="py-24 bg-[#faf8f5] border-b border-[#e5efe9]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#e8f5f1] border border-[#cbe4db] text-[#1d4d3e] text-xs font-bold tracking-wider uppercase mb-3">
        <span>CAPABILITIES &amp; MASTERY</span>
      </div>
      <h2 class="font-serif-vintage text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1d4d3e] tracking-tight">
        {isFa ? 'ماتریس تخصصی و توانمندی‌های مهندسی' : 'Technical Mastery & Core Domains'}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#526b60]">
        {isFa
          ? 'بیش از یک دهه تجربه در تلاقی مهندسی سیستم‌های پرسرعت، بانکداری نوین و مدل‌های پیشرفته هوش مصنوعی.'
          : 'A decade of battle-tested engineering at the crossroads of low-latency systems, next-gen FinTech, and state-of-the-art AI.'}
      </p>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {skillCategories.map((cat, idx) => (
        <div class="editorial-card rounded-3xl p-6 sm:p-8 relative group">
          
          <!-- Category Header -->
          <div class="flex items-center justify-between pb-5 mb-6 border-b border-[#e2ece7]">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-[#e8f5f1] border border-[#cbe4db] flex items-center justify-center text-[#1d4d3e] font-serif-vintage text-base font-bold">
                0{idx + 1}
              </div>
              <h3 class="font-serif-vintage text-xl font-bold text-[#1d4d3e] group-hover:text-[#e07253] transition-colors">
                {isFa ? cat.titleFa : cat.titleEn}
              </h3>
            </div>
            <span class="text-xs font-bold text-[#e07253] bg-[#fbf0ec] px-3 py-1 rounded-full">
              EXPERT
            </span>
          </div>

          <!-- Skill Items with Progress Bars -->
          <div class="flex flex-col gap-5">
            {cat.items.map((skill) => (
              <div class="flex flex-col gap-1.5">
                <div class="flex items-center justify-between text-xs sm:text-sm">
                  <span class="font-bold text-[#192b23]">{skill.name}</span>
                  <span class="font-mono font-bold text-[#e07253] text-xs">{skill.level}%</span>
                </div>
                
                <!-- Progress Bar Track -->
                <div class="h-2.5 w-full rounded-full bg-[#e8f5f1] overflow-hidden p-[1px] border border-[#d2e8df]">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-[#e07253] to-[#f2967e]"
                    style={`width: ${skill.level}%`}
                  ></div>
                </div>

                <!-- Note description -->
                <span class="text-[11px] text-[#526b60] font-light">
                  {isFa ? skill.noteFa : skill.noteEn}
                </span>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

---
// Web Audio API Synthesizer for Cyber Haptic Feedback
interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
---
<button
  id="audio-toggle-btn"
  type="button"
  aria-label={lang === 'fa' ? 'تغییر وضعیت صدا' : 'Toggle Audio FX'}
  title={lang === 'fa' ? 'افکت‌های صوتی سایبری' : 'Cyber Audio FX'}
  class="relative flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-mono border border-slate-700/60 bg-slate-900/60 backdrop-blur hover:border-cyan-400/50 hover:text-cyan-300 transition-all cursor-pointer group"
>
  <span class="flex items-center gap-0.5 h-3.5" id="audio-bars">
    <span class="w-0.5 h-1.5 bg-slate-500 rounded-full group-hover:bg-cyan-400 transition-all bar-1"></span>
    <span class="w-0.5 h-3 bg-slate-500 rounded-full group-hover:bg-cyan-400 transition-all bar-2"></span>
    <span class="w-0.5 h-2 bg-slate-500 rounded-full group-hover:bg-cyan-400 transition-all bar-3"></span>
    <span class="w-0.5 h-1 bg-slate-500 rounded-full group-hover:bg-cyan-400 transition-all bar-4"></span>
  </span>
  <span id="audio-status-text" class="text-[11px] text-slate-400 group-hover:text-cyan-300">
    {lang === 'fa' ? 'صدا: خاموش' : 'FX: OFF'}
  </span>
</button>

<style>
  .audio-active .bar-1 { animation: pulse-bar 0.8s ease-in-out infinite alternate; background-color: #00f5d4 !important; }
  .audio-active .bar-2 { animation: pulse-bar 1.2s ease-in-out infinite alternate 0.2s; background-color: #00f5d4 !important; }
  .audio-active .bar-3 { animation: pulse-bar 0.6s ease-in-out infinite alternate 0.4s; background-color: #00f5d4 !important; }
  .audio-active .bar-4 { animation: pulse-bar 1.0s ease-in-out infinite alternate 0.1s; background-color: #00f5d4 !important; }

  @keyframes pulse-bar {
    0% { height: 3px; }
    100% { height: 14px; }
  }
</style>

<script>
  let audioCtx: AudioContext | null = null;
  let soundEnabled = false;

  const btn = document.getElementById('audio-toggle-btn');
  const bars = document.getElementById('audio-bars');
  const statusText = document.getElementById('audio-status-text');
  const isFa = document.documentElement.lang === 'fa';

  function initAudio() {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
      if (AudioContextClass) {
        audioCtx = new AudioContextClass();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  function playCyberTone(freq: number, type: OscillatorType = 'sine', duration: number = 0.08, gainVal: number = 0.05) {
    if (!soundEnabled || !audioCtx) return;
    try {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.5, audioCtx.currentTime + duration);

      gain.gain.setValueAtTime(gainVal, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    } catch (e) {
      // Audio fallback
    }
  }

  function playBlip() {
    playCyberTone(880, 'sine', 0.05, 0.03);
  }

  function playChime() {
    if (!soundEnabled || !audioCtx) return;
    try {
      const notes = [523.25, 659.25, 783.99, 1046.50];
      notes.forEach((freq, idx) => {
        setTimeout(() => playCyberTone(freq, 'triangle', 0.12, 0.04), idx * 45);
      });
    } catch(e) {}
  }

  function playKeyClick() {
    playCyberTone(1200 + Math.random() * 400, 'square', 0.02, 0.015);
  }

  btn?.addEventListener('click', () => {
    initAudio();
    soundEnabled = !soundEnabled;
    if (soundEnabled) {
      btn.classList.add('audio-active');
      if (statusText) statusText.textContent = isFa ? 'صدا: فعال' : 'FX: ON';
      if (statusText) statusText.classList.add('text-cyan-400');
      playChime();
    } else {
      btn.classList.remove('audio-active');
      if (statusText) statusText.textContent = isFa ? 'صدا: خاموش' : 'FX: OFF';
      if (statusText) statusText.classList.remove('text-cyan-400');
    }
  });

  // Attach sound to interactive buttons and cards
  document.addEventListener('mouseover', (e) => {
    const target = (e.target as HTMLElement).closest('button, a, .glass-card');
    if (target && soundEnabled) {
      playBlip();
    }
  });

  // Expose global play functions
  (window as any).cyberAudio = {
    playBlip,
    playChime,
    playKeyClick,
    isEnabled: () => soundEnabled,
  };
</script>

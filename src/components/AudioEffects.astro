---
// Web Audio API Synthesizer for Retro Editorial Feedback
interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
---
<button
  id="audio-toggle-btn"
  type="button"
  aria-label={lang === 'fa' ? 'تغییر وضعیت صدا' : 'Toggle Audio FX'}
  title={lang === 'fa' ? 'افکت صوتی' : 'Sound FX'}
  class="relative flex items-center gap-2 px-2.5 py-1.5 rounded-md text-xs font-mono border border-[#276652] bg-[#143a2e] hover:border-[#e07253] hover:text-[#f4d5cc] text-emerald-200 transition-all cursor-pointer group"
>
  <span class="flex items-center gap-0.5 h-3" id="audio-bars">
    <span class="w-0.5 h-1.5 bg-emerald-400 rounded-full bar-1"></span>
    <span class="w-0.5 h-3 bg-emerald-400 rounded-full bar-2"></span>
    <span class="w-0.5 h-2 bg-emerald-400 rounded-full bar-3"></span>
  </span>
  <span id="audio-status-text" class="text-[11px] font-bold">
    {lang === 'fa' ? 'صدا' : 'SFX'}
  </span>
</button>

<style>
  .audio-active .bar-1 { animation: pulse-bar 0.8s ease-in-out infinite alternate; background-color: #e07253 !important; }
  .audio-active .bar-2 { animation: pulse-bar 1.2s ease-in-out infinite alternate 0.2s; background-color: #e07253 !important; }
  .audio-active .bar-3 { animation: pulse-bar 0.6s ease-in-out infinite alternate 0.4s; background-color: #e07253 !important; }

  @keyframes pulse-bar {
    0% { height: 3px; }
    100% { height: 12px; }
  }
</style>

<script>
  let audioCtx: AudioContext | null = null;
  let soundEnabled = false;

  const btn = document.getElementById('audio-toggle-btn');
  const statusText = document.getElementById('audio-status-text');
  const isFa = document.documentElement.lang === 'fa';

  function initAudio() {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
      if (AudioContextClass) {
        audioCtx = new AudioContextClass();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  function playTone(freq: number, type: OscillatorType = 'sine', duration: number = 0.08, gainVal: number = 0.04) {
    if (!soundEnabled || !audioCtx) return;
    try {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.7, audioCtx.currentTime + duration);

      gain.gain.setValueAtTime(gainVal, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    } catch (e) {}
  }

  function playBlip() {
    playTone(520, 'sine', 0.04, 0.02);
  }

  function playChime() {
    if (!soundEnabled || !audioCtx) return;
    try {
      const notes = [440, 554.37, 659.25];
      notes.forEach((freq, idx) => {
        setTimeout(() => playTone(freq, 'triangle', 0.1, 0.03), idx * 50);
      });
    } catch(e) {}
  }

  function playKeyClick() {
    playTone(700 + Math.random() * 200, 'square', 0.02, 0.01);
  }

  btn?.addEventListener('click', () => {
    initAudio();
    soundEnabled = !soundEnabled;
    if (soundEnabled) {
      btn.classList.add('audio-active');
      if (statusText) statusText.textContent = isFa ? 'صدا: فعال' : 'SFX: ON';
      playChime();
    } else {
      btn.classList.remove('audio-active');
      if (statusText) statusText.textContent = isFa ? 'صدا' : 'SFX';
    }
  });

  // Attach sound to interactive buttons
  document.addEventListener('mouseover', (e) => {
    const target = (e.target as HTMLElement).closest('button, a, .editorial-card');
    if (target && soundEnabled) {
      playBlip();
    }
  });

  (window as any).cyberAudio = {
    playBlip,
    playChime,
    playKeyClick,
    isEnabled: () => soundEnabled,
  };
</script>

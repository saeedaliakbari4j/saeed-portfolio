---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { profile } = portfolioData;
---

<section id="contact" class="py-14 sm:py-20 bg-[#f8fafc]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-800 text-xs font-bold tracking-wider uppercase mb-2">
        <span>GET IN TOUCH</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">
        {isFa ? 'ارسال پیام و آغاز گفتگو' : 'Start a Conversation'}
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-slate-600">
        {isFa
          ? 'پیام‌های این فرم مستقیماً به ایمیل saeedaliakbari4j@gmail.com ارسال و پیگیری می‌شوند.'
          : 'Messages submitted here are delivered directly to saeedaliakbari4j@gmail.com.'}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      
      <!-- Left Column: Direct Info Cards -->
      <div class="lg:col-span-5 flex flex-col gap-3.5">
        
        <!-- Email Copy Card -->
        <div class="modern-card rounded-2xl p-5 relative group">
          <div class="flex items-center justify-between mb-2.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700">DIRECT EMAIL</span>
            <button
              id="copy-email-btn"
              type="button"
              class="px-2.5 py-1 rounded-md text-xs font-bold bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-700 transition-all cursor-pointer"
            >
              <span id="copy-text">{isFa ? 'کپی آدرس' : 'Copy'}</span>
            </button>
          </div>
          <div class="text-sm sm:text-base font-bold font-mono text-slate-900 break-all mb-1 select-all" id="target-email">
            {profile.email}
          </div>
          <p class="text-[11px] text-slate-500">
            {isFa ? 'پاسخگویی سریع برای درخواست‌های مشاوره، هدایت فنی و پروژه‌های نوآورانه' : 'Monitored daily for engineering and consulting inquiries.'}
          </p>
        </div>

        <!-- LinkedIn Card -->
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="modern-card rounded-2xl p-5 block group transition-all"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-sky-700">LINKEDIN NETWORK</span>
            <span class="text-xs text-slate-400 group-hover:text-sky-600 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform">→</span>
          </div>
          <div class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-sky-700 transition-colors">
            linkedin.com/in/saeed-aliakbari
          </div>
          <p class="text-[11px] text-slate-500 mt-0.5">
            {isFa ? 'شبکه حرفه‌ای با بیش از ۳,۰۰۰ متخصص صنعت نرم‌افزار' : 'Professional network of 3,000+ technology leaders.'}
          </p>
        </a>

        <!-- GitHub Card -->
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="modern-card rounded-2xl p-5 block group transition-all"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-700">GITHUB REPOSITORIES</span>
            <span class="text-xs text-slate-400 group-hover:text-slate-900 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform">→</span>
          </div>
          <div class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-emerald-700 transition-colors">
            github.com/saeedaliakbari4j
          </div>
          <p class="text-[11px] text-slate-500 mt-0.5">
            {isFa ? 'کدهای منبع، پایان‌نامه RAG و ابزارهای بانکی' : 'Open-source code, thesis RAG models, and tools.'}
          </p>
        </a>

      </div>

      <!-- Right Column: Clean Working Form -->
      <div class="lg:col-span-7">
        <div class="modern-card rounded-2xl p-6 sm:p-7 relative bg-white">
          
          <div class="pb-3 mb-4 border-b border-slate-100 flex items-center justify-between">
            <div>
              <h3 class="text-base sm:text-lg font-bold text-slate-900">
                {isFa ? 'ارسال پیام مستقیم به سعید علی‌اکبری' : 'Send a Direct Message'}
              </h3>
              <p class="text-[11px] text-slate-500 mt-0.5">
                {isFa ? 'پیام شما به ایمیل saeedaliakbari4j@gmail.com تحویل داده می‌شود.' : 'Message will be delivered straight to saeedaliakbari4j@gmail.com'}
              </p>
            </div>
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          </div>

          <form id="contact-form" class="space-y-3.5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                  {isFa ? 'نام و نام‌خانوادگی / شرکت' : 'Your Name / Org'}
                </label>
                <input
                  type="text"
                  name="name"
                  required
                  id="form-name"
                  placeholder={isFa ? 'مثال: علیرضا محمدی' : 'e.g. John Doe'}
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none transition-all"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                  {isFa ? 'آدرس ایمیل شما' : 'Your Email Address'}
                </label>
                <input
                  type="email"
                  name="email"
                  required
                  id="form-contact"
                  placeholder="name@example.com"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none transition-all"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">
                {isFa ? 'موضوع پیام' : 'Subject'}
              </label>
              <input
                type="text"
                name="subject"
                required
                id="form-subject"
                placeholder={isFa ? 'همکاری در پروژه RAG / مشاوره معماری نرم‌افزار' : 'RAG Pipeline Project / Consulting'}
                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none transition-all"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">
                {isFa ? 'متن پیام' : 'Message'}
              </label>
              <textarea
                rows="3"
                name="message"
                required
                id="form-message"
                placeholder={isFa ? 'توضیحات کوتاه درباره نیازمندی یا پروژه خود بنویسید...' : 'Tell me a bit about what you need...'}
                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none transition-all resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              id="form-submit-btn"
              class="w-full py-3 rounded-xl font-bold text-xs sm:text-sm uppercase tracking-wider text-white bg-emerald-600 hover:bg-emerald-700 transition-all shadow-md shadow-emerald-600/20 cursor-pointer flex items-center justify-center gap-2"
            >
              <span id="btn-spinner" class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
              <span id="btn-text">{isFa ? 'ارسال پیام به ایمیل سعید' : 'SEND MESSAGE'}</span>
              <span class="rtl:rotate-180">→</span>
            </button>
          </form>

          <!-- Success Alert Card -->
          <div id="form-success-banner" class="hidden mt-3.5 p-4 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-900 text-xs sm:text-sm flex items-center gap-2.5">
            <span class="text-lg font-bold text-emerald-600">✓</span>
            <div>
              <div class="font-bold">{isFa ? 'پیام شما با موفقیت ارسال شد!' : 'Message Successfully Transmitted!'}</div>
              <div class="text-[11px] text-emerald-700 mt-0.5">
                {isFa ? 'پیام به آدرس saeedaliakbari4j@gmail.com ارسال گردید؛ در اسرع وقت با شما تماس گرفته می‌شود.' : 'Message was delivered to saeedaliakbari4j@gmail.com; Saeed will follow up shortly.'}
              </div>
            </div>
          </div>

          <!-- Error Alert Card -->
          <div id="form-error-banner" class="hidden mt-3.5 p-4 rounded-xl bg-red-50 border border-red-300 text-red-900 text-xs sm:text-sm flex items-center gap-2.5">
            <span class="text-lg font-bold text-red-600">!</span>
            <div>
              <div class="font-bold">{isFa ? 'ارسال مستقیم با مشکل مواجه شد' : 'Direct send encountered an issue'}</div>
              <div class="text-[11px] text-red-700 mt-0.5">
                {isFa ? 'لطفاً مستقیماً به آدرس saeedaliakbari4j@gmail.com ایمیل بزنید.' : 'Please email directly to saeedaliakbari4j@gmail.com'}
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Copy email logic
  const copyBtn = document.getElementById('copy-email-btn');
  const targetEmail = document.getElementById('target-email');
  const copyText = document.getElementById('copy-text');
  const isFa = document.documentElement.lang === 'fa';

  copyBtn?.addEventListener('click', () => {
    const email = targetEmail?.textContent?.trim() || 'saeedaliakbari4j@gmail.com';
    navigator.clipboard.writeText(email).then(() => {
      if (copyText) copyText.textContent = isFa ? 'کپی شد! ✓' : 'Copied! ✓';
      if ((window as any).cyberAudio?.isEnabled?.()) {
        (window as any).cyberAudio.playChime();
      }
      setTimeout(() => {
        if (copyText) copyText.textContent = isFa ? 'کپی آدرس' : 'Copy';
      }, 2500);
    });
  });

  // Contact form submission to saeedaliakbari4j@gmail.com via FormSubmit AJAX
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement;
  const btnSpinner = document.getElementById('btn-spinner');
  const btnText = document.getElementById('btn-text');
  const successBanner = document.getElementById('form-success-banner');
  const errorBanner = document.getElementById('form-error-banner');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (btnSpinner) btnSpinner.classList.remove('hidden');
    if (btnText) btnText.textContent = isFa ? 'در حال ارسال...' : 'Sending...';
    if (submitBtn) submitBtn.disabled = true;
    successBanner?.classList.add('hidden');
    errorBanner?.classList.add('hidden');

    const name = (document.getElementById('form-name') as HTMLInputElement)?.value || '';
    const email = (document.getElementById('form-contact') as HTMLInputElement)?.value || '';
    const subject = (document.getElementById('form-subject') as HTMLInputElement)?.value || '';
    const message = (document.getElementById('form-message') as HTMLTextAreaElement)?.value || '';

    try {
      const response = await fetch('https://formsubmit.co/ajax/saeedaliakbari4j@gmail.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          _subject: `New Message from Portfolio: ${subject}`,
          name: name,
          email: email,
          subject: subject,
          message: message
        })
      });

      if (response.ok) {
        successBanner?.classList.remove('hidden');
        form.reset();
        
        try {
          const confetti = (await import('canvas-confetti')).default;
          confetti({
            particleCount: 70,
            spread: 55,
            origin: { y: 0.7 }
          });
        } catch(err) {}

        if ((window as any).cyberAudio?.isEnabled?.()) {
          (window as any).cyberAudio.playChime();
        }
      } else {
        errorBanner?.classList.remove('hidden');
      }
    } catch (err) {
      // Fallback
      errorBanner?.classList.remove('hidden');
    } finally {
      if (btnSpinner) btnSpinner.classList.add('hidden');
      if (btnText) btnText.textContent = isFa ? 'ارسال پیام به ایمیل سعید' : 'SEND MESSAGE';
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

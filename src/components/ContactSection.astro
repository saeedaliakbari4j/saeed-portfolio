---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { profile } = portfolioData;
---

<section id="contact" class="py-14 sm:py-16 bg-[#faf8f5]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#eef7f4] border border-[#cbe4db] text-[#1d4d3e] text-[11px] font-bold tracking-wider uppercase mb-2">
        <span>GET IN TOUCH</span>
      </div>
      <h2 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-[#1d4d3e] tracking-tight font-vintage">
        {isFa ? 'برقراری ارتباط و آغاز همکاری' : 'Start a Conversation'}
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-[#5a7369]">
        {isFa
          ? 'برای مشاوره معماری هوش مصنوعی، پیاده‌سازی سیستم‌های RAG یا هدایت پروژه‌های نرم‌افزاری پیام بگذارید.'
          : 'Ready to architect next-gen RAG pipelines or scale your software team? Let’s connect.'}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- Left Column: Direct Info Cards -->
      <div class="lg:col-span-5 flex flex-col gap-4">
        
        <!-- Email Copy Card -->
        <div class="editorial-card rounded-2xl p-5 relative group">
          <div class="flex items-center justify-between mb-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#d96245]">DIRECT EMAIL</span>
            <button
              id="copy-email-btn"
              type="button"
              class="px-2.5 py-1 rounded text-[11px] font-bold uppercase bg-[#eef7f4] hover:bg-[#1d4d3e] hover:text-white text-[#1d4d3e] transition-all cursor-pointer"
            >
              <span id="copy-text">{isFa ? 'کپی آدرس' : 'Copy'}</span>
            </button>
          </div>
          <div class="text-sm sm:text-base font-bold font-mono text-[#1d4d3e] break-all mb-1 select-all" id="target-email">
            {profile.email}
          </div>
          <p class="text-[11px] text-[#5a7369]">
            {isFa ? 'پاسخگویی سریع برای درخواست‌های مشاوره و همکاری فنی' : 'Direct inbox monitored for engineering inquiries.'}
          </p>
        </div>

        <!-- LinkedIn Card -->
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-card rounded-2xl p-5 block group transition-all"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#d96245]">LINKEDIN</span>
            <span class="text-xs text-[#1d4d3e] group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform">→</span>
          </div>
          <div class="text-base font-bold text-[#1d4d3e] group-hover:text-[#d96245] transition-colors font-vintage">
            linkedin.com/in/saeed-aliakbari
          </div>
          <p class="text-[11px] text-[#5a7369] mt-0.5">
            {isFa ? 'شبکه حرفه‌ای با بیش از ۳,۰۰۰ متخصص' : 'Network of 3,000+ technology leaders.'}
          </p>
        </a>

        <!-- GitHub Card -->
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-card rounded-2xl p-5 block group transition-all"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#d96245]">GITHUB</span>
            <span class="text-xs text-[#1d4d3e] group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform">→</span>
          </div>
          <div class="text-base font-bold text-[#1d4d3e] group-hover:text-[#d96245] transition-colors font-vintage">
            github.com/saeedaliakbari4j
          </div>
          <p class="text-[11px] text-[#5a7369] mt-0.5">
            {isFa ? 'کدهای منبع، پایان‌نامه RAG و ابزارهای بانکی' : 'Open-source thesis RAG models & algorithms.'}
          </p>
        </a>

      </div>

      <!-- Right Column: Clean Editorial Form -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-2xl p-5 sm:p-7 border border-[#e2ece7] shadow-sm relative">
          
          <div class="pb-3 mb-4 border-b border-[#e2ece7]">
            <h3 class="text-lg font-bold text-[#1d4d3e] font-vintage">
              {isFa ? 'ارسال پیام مستقیم به سعید' : 'Send a Message'}
            </h3>
            <p class="text-[11px] text-[#5a7369] mt-0.5">
              {isFa ? 'پیام شما مستقیماً دریافت و در سریع‌ترین زمان بررسی می‌شود.' : 'Fill out the form below and I will get back to you shortly.'}
            </p>
          </div>

          <form id="contact-form" class="space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-bold text-[#1d4d3e] mb-1">
                  {isFa ? 'نام و نام‌خانوادگی / شرکت' : 'Your Name / Org'}
                </label>
                <input
                  type="text"
                  required
                  id="form-name"
                  placeholder={isFa ? 'مثال: علیرضا محمدی' : 'e.g. John Doe'}
                  class="w-full px-3 py-2 rounded-lg bg-[#faf8f5] border border-[#cbe4db] text-xs text-[#192b23] focus:border-[#1d4d3e] outline-none transition-all"
                />
              </div>

              <div>
                <label class="block text-[11px] font-bold text-[#1d4d3e] mb-1">
                  {isFa ? 'آدرس ایمیل' : 'Email Address'}
                </label>
                <input
                  type="email"
                  required
                  id="form-contact"
                  placeholder="name@example.com"
                  class="w-full px-3 py-2 rounded-lg bg-[#faf8f5] border border-[#cbe4db] text-xs text-[#192b23] focus:border-[#1d4d3e] outline-none transition-all"
                />
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-bold text-[#1d4d3e] mb-1">
                {isFa ? 'موضوع پیام' : 'Subject'}
              </label>
              <input
                type="text"
                required
                id="form-subject"
                placeholder={isFa ? 'همکاری در پروژه RAG / مشاوره فنی' : 'RAG Pipeline Project / Consulting'}
                class="w-full px-3 py-2 rounded-lg bg-[#faf8f5] border border-[#cbe4db] text-xs text-[#192b23] focus:border-[#1d4d3e] outline-none transition-all"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold text-[#1d4d3e] mb-1">
                {isFa ? 'متن پیام' : 'Message'}
              </label>
              <textarea
                rows="3"
                required
                id="form-message"
                placeholder={isFa ? 'توضیحات کوتاه درباره نیازمندی یا پروژه خود بنویسید...' : 'Tell me a bit about what you need...'}
                class="w-full px-3 py-2 rounded-lg bg-[#faf8f5] border border-[#cbe4db] text-xs text-[#192b23] focus:border-[#1d4d3e] outline-none transition-all resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              id="form-submit-btn"
              class="w-full py-2.5 rounded-lg font-bold uppercase tracking-wider text-xs text-white bg-[#d96245] hover:bg-[#c45237] transition-all cursor-pointer flex items-center justify-center gap-1.5"
            >
              <span>{isFa ? 'ارسال پیام' : 'SEND MESSAGE'}</span>
              <span>→</span>
            </button>
          </form>

          <!-- Success Alert Card -->
          <div id="form-success-banner" class="hidden mt-3 p-3 rounded-lg bg-[#eef7f4] border border-[#a2cfc0] text-[#1d4d3e] text-xs flex items-center gap-2">
            <span class="text-base font-bold text-emerald-700">✓</span>
            <div>
              <div class="font-bold">{isFa ? 'پیام شما با موفقیت ثبت شد!' : 'Message Successfully Sent!'}</div>
              <div class="text-[10px] text-[#5a7369] mt-0.5">
                {isFa ? 'سعید در سریع‌ترین زمان ممکن پاسخ شما را ارسال خواهد کرد.' : 'Saeed will follow up with you at the provided email.'}
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Copy email logic
  const copyBtn = document.getElementById('copy-email-btn');
  const targetEmail = document.getElementById('target-email');
  const copyText = document.getElementById('copy-text');
  const isFa = document.documentElement.lang === 'fa';

  copyBtn?.addEventListener('click', () => {
    const email = targetEmail?.textContent?.trim() || 'ai-bpmellat@outlook.com';
    navigator.clipboard.writeText(email).then(() => {
      if (copyText) copyText.textContent = isFa ? 'کپی شد! ✓' : 'Copied! ✓';
      if ((window as any).cyberAudio?.isEnabled?.()) {
        (window as any).cyberAudio.playChime();
      }
      setTimeout(() => {
        if (copyText) copyText.textContent = isFa ? 'کپی آدرس' : 'Copy';
      }, 2500);
    });
  });

  // Contact form submission
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successBanner = document.getElementById('form-success-banner');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    try {
      const confetti = (await import('canvas-confetti')).default;
      confetti({
        particleCount: 60,
        spread: 50,
        origin: { y: 0.7 }
      });
    } catch(err) {}

    if ((window as any).cyberAudio?.isEnabled?.()) {
      (window as any).cyberAudio.playChime();
    }

    successBanner?.classList.remove('hidden');
    form.reset();
  });
</script>

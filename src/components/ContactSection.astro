---
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang: 'fa' | 'en';
}
const { lang } = Astro.props;
const isFa = lang === 'fa';
const { profile } = portfolioData;
---

<section id="contact" class="py-24 bg-white border-b border-[#e5efe9]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#e8f5f1] border border-[#cbe4db] text-[#1d4d3e] text-xs font-bold tracking-wider uppercase mb-3">
        <span>LET'S WORK TOGETHER</span>
      </div>
      <h2 class="font-serif-vintage text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1d4d3e] tracking-tight">
        {isFa ? 'برقراری ارتباط و آغاز همکاری' : 'Start a Conversation'}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#526b60]">
        {isFa
          ? 'آیا برای پیاده‌سازی سیستم‌های RAG، پلتفرم‌های مقیاس‌پذیر بانکی یا مشاوره معماری نرم‌افزار به راهبری تخصصی نیاز دارید؟ بیایید گفتگو را آغاز کنیم.'
          : 'Ready to architect next-gen RAG pipelines, mission-critical FinTech infrastructure, or scale your software team? Let’s connect.'}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Direct Info Cards -->
      <div class="lg:col-span-5 flex flex-col gap-5">
        
        <!-- Email Copy Card -->
        <div class="editorial-card rounded-3xl p-6 sm:p-7 relative group">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-[#e07253]">DIRECT EMAIL</span>
            <button
              id="copy-email-btn"
              type="button"
              class="px-3.5 py-1.5 rounded-lg text-xs font-bold uppercase bg-[#e8f5f1] hover:bg-[#1d4d3e] hover:text-white text-[#1d4d3e] transition-all cursor-pointer"
            >
              <span id="copy-text">{isFa ? 'کپی آدرس' : 'Copy Email'}</span>
            </button>
          </div>
          <div class="text-lg sm:text-xl font-bold font-mono text-[#1d4d3e] break-all mb-2 select-all" id="target-email">
            {profile.email}
          </div>
          <p class="text-xs text-[#526b60] font-light">
            {isFa ? 'پاسخگویی سریع برای درخواست‌های مشاوره و همکاری فنی' : 'Direct inbox monitored for engineering & consulting inquiries.'}
          </p>
        </div>

        <!-- LinkedIn Card -->
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-card rounded-3xl p-6 sm:p-7 block group transition-all"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[#e07253]">LINKEDIN NETWORK</span>
            <span class="text-[#1d4d3e] group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform">→</span>
          </div>
          <div class="font-serif-vintage text-xl font-bold text-[#1d4d3e] group-hover:text-[#e07253] transition-colors">
            linkedin.com/in/saeed-aliakbari
          </div>
          <p class="text-xs text-[#526b60] font-light mt-1">
            {isFa ? 'شبکه حرفه‌ای با بیش از ۳,۰۰۰ همراه و متخصص صنعت فناوری' : 'Professional network of 3,000+ technology leaders and engineers.'}
          </p>
        </a>

        <!-- GitHub Card -->
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-card rounded-3xl p-6 sm:p-7 block group transition-all"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[#e07253]">GITHUB REPOSITORIES</span>
            <span class="text-[#1d4d3e] group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform">→</span>
          </div>
          <div class="font-serif-vintage text-xl font-bold text-[#1d4d3e] group-hover:text-[#e07253] transition-colors">
            github.com/saeedaliakbari4j
          </div>
          <p class="text-xs text-[#526b60] font-light mt-1">
            {isFa ? 'کدهای منبع، پایان‌نامه RAG، ابزارهای بانکی و پروژه‌های متن‌باز' : 'Open-source thesis RAG models, banking algorithms, and utilities.'}
          </p>
        </a>

      </div>

      <!-- Right Column: Clean Editorial Form -->
      <div class="lg:col-span-7">
        <div class="bg-[#faf8f5] rounded-3xl p-6 sm:p-10 border-2 border-[#1d4d3e]/15 shadow-md relative">
          
          <div class="pb-4 mb-6 border-b border-[#e2ece7]">
            <h3 class="font-serif-vintage text-2xl font-bold text-[#1d4d3e]">
              {isFa ? 'ارسال پیام مستقیم به سعید' : 'Send a Direct Message'}
            </h3>
            <p class="text-xs text-[#526b60] mt-1">
              {isFa ? 'پیام شما مستقیماً دریافت و در سریع‌ترین زمان بررسی می‌شود.' : 'Fill out the form below and I will get back to you shortly.'}
            </p>
          </div>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-[#1d4d3e] uppercase tracking-wider mb-1.5">
                  {isFa ? 'نام و نام‌خانوادگی / شرکت' : 'Your Name / Org'}
                </label>
                <input
                  type="text"
                  required
                  id="form-name"
                  placeholder={isFa ? 'مثال: علیرضا محمدی' : 'e.g. Sarah Jenkins'}
                  class="w-full px-4 py-3 rounded-xl bg-white border border-[#cbe4db] text-sm text-[#192b23] focus:border-[#1d4d3e] focus:ring-1 focus:ring-[#1d4d3e] outline-none transition-all"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-[#1d4d3e] uppercase tracking-wider mb-1.5">
                  {isFa ? 'آدرس ایمیل' : 'Email Address'}
                </label>
                <input
                  type="email"
                  required
                  id="form-contact"
                  placeholder="name@example.com"
                  class="w-full px-4 py-3 rounded-xl bg-white border border-[#cbe4db] text-sm text-[#192b23] focus:border-[#1d4d3e] focus:ring-1 focus:ring-[#1d4d3e] outline-none transition-all"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-[#1d4d3e] uppercase tracking-wider mb-1.5">
                {isFa ? 'موضوع پیام' : 'Subject'}
              </label>
              <input
                type="text"
                required
                id="form-subject"
                placeholder={isFa ? 'همکاری در پروژه RAG / مشاوره فنی' : 'RAG Pipeline Project / Consulting'}
                class="w-full px-4 py-3 rounded-xl bg-white border border-[#cbe4db] text-sm text-[#192b23] focus:border-[#1d4d3e] focus:ring-1 focus:ring-[#1d4d3e] outline-none transition-all"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-[#1d4d3e] uppercase tracking-wider mb-1.5">
                {isFa ? 'متن پیام' : 'Message'}
              </label>
              <textarea
                rows="4"
                required
                id="form-message"
                placeholder={isFa ? 'توضیحات کوتاه درباره نیازمندی یا پروژه خود بنویسید...' : 'Tell me a bit about what you need...'}
                class="w-full px-4 py-3 rounded-xl bg-white border border-[#cbe4db] text-sm text-[#192b23] focus:border-[#1d4d3e] focus:ring-1 focus:ring-[#1d4d3e] outline-none transition-all resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              id="form-submit-btn"
              class="w-full py-4 rounded-xl font-bold uppercase tracking-wider text-sm text-white bg-[#e07253] hover:bg-[#cb5e40] shadow-md hover:shadow-lg transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span>{isFa ? 'ارسال پیام' : 'SEND MESSAGE'}</span>
              <span>→</span>
            </button>
          </form>

          <!-- Success Alert Card -->
          <div id="form-success-banner" class="hidden mt-4 p-4 rounded-xl bg-[#e8f5f1] border border-[#a2cfc0] text-[#1d4d3e] text-sm flex items-center gap-3">
            <span class="text-xl">✓</span>
            <div>
              <div class="font-bold">{isFa ? 'پیام شما با موفقیت ثبت شد!' : 'Message Successfully Sent!'}</div>
              <div class="text-xs text-[#526b60] mt-0.5">
                {isFa ? 'سعید در سریع‌ترین زمان ممکن پاسخ شما را ارسال خواهد کرد.' : 'Saeed will follow up with you at the provided email.'}
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Copy email logic
  const copyBtn = document.getElementById('copy-email-btn');
  const targetEmail = document.getElementById('target-email');
  const copyText = document.getElementById('copy-text');
  const isFa = document.documentElement.lang === 'fa';

  copyBtn?.addEventListener('click', () => {
    const email = targetEmail?.textContent?.trim() || 'ai-bpmellat@outlook.com';
    navigator.clipboard.writeText(email).then(() => {
      if (copyText) copyText.textContent = isFa ? 'کپی شد! ✓' : 'Copied! ✓';
      if ((window as any).cyberAudio?.isEnabled?.()) {
        (window as any).cyberAudio.playChime();
      }
      setTimeout(() => {
        if (copyText) copyText.textContent = isFa ? 'کپی آدرس' : 'Copy Email';
      }, 2500);
    });
  });

  // Contact form submission
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successBanner = document.getElementById('form-success-banner');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    try {
      const confetti = (await import('canvas-confetti')).default;
      confetti({
        particleCount: 80,
        spread: 60,
        origin: { y: 0.7 }
      });
    } catch(err) {}

    if ((window as any).cyberAudio?.isEnabled?.()) {
      (window as any).cyberAudio.playChime();
    }

    successBanner?.classList.remove('hidden');
    form.reset();
  });
</script>

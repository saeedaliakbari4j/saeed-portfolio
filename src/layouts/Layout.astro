---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import InteractiveTerminal from '../components/InteractiveTerminal.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'fa' | 'en';
}

const { title, description, lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';
const dir = isFa ? 'rtl' : 'ltr';
---

<!DOCTYPE html>
<html lang={lang} dir={dir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Saeed Aliakbari" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/saeed.jpg" />

    <!-- Google Fonts: Vazirmatn & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#f8fafc] text-[#0f172a] min-h-screen selection:bg-emerald-500/20 selection:text-emerald-900 antialiased">
    <!-- Navbar -->
    <Navbar lang={lang} />

    <!-- Main Content Area -->
    <main class="relative z-10 pt-[76px]">
      <slot />
    </main>

    <!-- Footer -->
    <Footer lang={lang} />

    <!-- Interactive Terminal Console -->
    <InteractiveTerminal lang={lang} />
  </body>
</html>

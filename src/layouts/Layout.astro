---
import '../styles/global.css';
import NeuralBackground from '../components/NeuralBackground.astro';
import Navbar from '../components/Navbar.astro';
import InteractiveTerminal from '../components/InteractiveTerminal.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'fa' | 'en';
}

const { title, description, lang = 'fa' } = Astro.props;
const isFa = lang === 'fa';
const dir = isFa ? 'rtl' : 'ltr';
---

<!DOCTYPE html>
<html lang={lang} dir={dir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Saeed Aliakbari, سعید علی اکبری, AI Architect, RAG, FinTech, Rayamate, Behpardakht Mellat, Astro, Python, LLM" />
    <meta name="author" content="Saeed Aliakbari" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/saeed.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/saeed.jpg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&family=Space+Grotesk:wght@400;500;600;700;800&family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#05070d] text-slate-100 min-h-screen selection:bg-cyan-500/30 selection:text-cyan-200">
    <!-- Interactive Background Canvas -->
    <NeuralBackground />

    <!-- Navigation Header -->
    <Navbar lang={lang} />

    <!-- Main Content Slot -->
    <main class="relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <Footer lang={lang} />

    <!-- Interactive Holographic Terminal OS -->
    <InteractiveTerminal lang={lang} />
  </body>
</html>
